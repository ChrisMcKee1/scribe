<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Scribe.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The whole pill follows Windows text size as one unit: the window is the 264 x 110 DIP window times the text scale
         (PillGeometry), and this content, laid out at exactly 264 x 110, is drawn scaled to fill it, so every line keeps its
         100% width and its text is drawn at the size Windows asks for. No TextBlock scales its own text, which would scale
         it twice. -->
    <Viewbox x:Name="PillScale" Stretch="Uniform">
        <Grid x:Name="RootGrid" Width="264" Height="110" Background="Transparent">
            <Grid.Resources>
                <!-- Motion, all of it gated on Windows "Animation effects" (UISettings.AnimationsEnabled, read at each show):
                     the processing dots, and a fade in and out. With it off the dots stand still and the pill simply appears
                     and goes; the level bars follow the level either way, because that is information. -->
                <Storyboard x:Key="ProcessingStoryboard">
                    <DoubleAnimation Storyboard.TargetName="Dot1Transform" Storyboard.TargetProperty="Y"
                                     From="0" To="-5" Duration="0:0:0.45" AutoReverse="True"
                                     RepeatBehavior="Forever" BeginTime="0:0:0">
                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Dot2Transform" Storyboard.TargetProperty="Y"
                                     From="0" To="-5" Duration="0:0:0.45" AutoReverse="True"
                                     RepeatBehavior="Forever" BeginTime="0:0:0.12">
                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Dot3Transform" Storyboard.TargetProperty="Y"
                                     From="0" To="-5" Duration="0:0:0.45" AutoReverse="True"
                                     RepeatBehavior="Forever" BeginTime="0:0:0.24">
                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Key="FadeInStoryboard">
                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.12"/>
                </Storyboard>
                <Storyboard x:Key="FadeOutStoryboard">
                    <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0" Duration="0:0:0.15"/>
                </Storyboard>
            </Grid.Resources>

            <!-- The pill (Signal On, palette decision section 5): an opaque face, a sheen over its top 45% and one edge, drawn
                 inside it, for the state. No plate, no bloom, no glow and no red wash. Every brush is a theme resource from
                 App.xaml, so a contrast theme draws it in system colours. -->
            <Grid x:Name="Pill" Margin="27" IsHitTestVisible="False">
                <Border CornerRadius="18" Background="{ThemeResource PillFaceBrush}"/>
                <Border CornerRadius="18" Background="{ThemeResource PillSheenBrush}"/>
                <Border x:Name="ListeningEdge" CornerRadius="18"
                        BorderBrush="{ThemeResource PillListeningEdgeBrush}"
                        BorderThickness="{ThemeResource PillListeningEdgeThickness}"/>
                <Border x:Name="NeutralEdge" CornerRadius="18" Visibility="Collapsed"
                        BorderBrush="{ThemeResource PillNeutralEdgeBrush}"
                        BorderThickness="{ThemeResource PillQuietEdgeThickness}"/>
                <Border x:Name="ErrorEdge" CornerRadius="18" Visibility="Collapsed"
                        BorderBrush="{ThemeResource PillErrorEdgeBrush}"
                        BorderThickness="{ThemeResource PillQuietEdgeThickness}"/>

                <Grid Margin="16,9">
                    <!-- Listening: five level bars in the icon's proportions. Each is laid out 16 DIP tall and scaled by the
                         level (ScaleY), so a level update never runs a layout pass; 0.25 is the 4 DIP floor. -->
                    <Grid x:Name="ListeningContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0"
                                       Fill="{ThemeResource PillLevelBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar1Scale" ScaleY="0.25"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0"
                                       Fill="{ThemeResource PillLevelBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar2Scale" ScaleY="0.25"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0"
                                       Fill="{ThemeResource PillLevelBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar3Scale" ScaleY="0.25"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0"
                                       Fill="{ThemeResource PillLevelBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar4Scale" ScaleY="0.25"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{ThemeResource PillLevelBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="Bar5Scale" ScaleY="0.25"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"
                                   Text="Listening…" Foreground="{ThemeResource PillTextBrush}"
                                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   IsTextScaleFactorEnabled="False"/>
                    </Grid>

                    <!-- Processing: three dots, the same for transcribing and for AI cleanup; the words say which. -->
                    <Grid x:Name="ProcessingContent" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,4,0" Fill="{ThemeResource PillDotBrush}">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="Dot1Transform"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="7" Height="7" Margin="0,0,4,0" Fill="{ThemeResource PillDotBrush}">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="Dot2Transform"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource PillDotBrush}">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="Dot3Transform"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </StackPanel>

                        <TextBlock x:Name="ProcessingText" Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"
                                   Text="Transcribing…" Foreground="{ThemeResource PillTextBrush}"
                                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   IsTextScaleFactorEnabled="False"/>
                    </Grid>

                    <!-- Typed: all of the text arrived, the space after it included. A check, briefly. -->
                    <Grid x:Name="TypedContent" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Width="13" Height="10" VerticalAlignment="Center"
                              Data="M1,5 L5,9 L12,1" Stroke="{ThemeResource PillSuccessBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="Typed" Foreground="{ThemeResource PillTextBrush}"
                                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   IsTextScaleFactorEnabled="False"/>
                    </Grid>

                    <!-- A notice with a second line: "Typed without AI cleanup" and the reason (a caution triangle on the
                         neutral edge), or "Nothing typed" / "Not all of it was typed" and the next step (an error icon on
                         the error edge). -->
                    <Grid x:Name="NoticeContent" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                            <Path x:Name="CautionIcon"
                                  Data="M7,1.5 L13,12.5 L1,12.5 Z M7,5.5 L7,8.5 M7,10.6 L7,10.7"
                                  Stroke="{ThemeResource PillCautionBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path x:Name="ErrorIcon" Visibility="Collapsed"
                                  Data="M2,2 L12,12 M12,2 L2,12"
                                  Stroke="{ThemeResource PillErrorBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NoticeTitle" Foreground="{ThemeResource PillTextBrush}"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       IsTextScaleFactorEnabled="False"/>
                            <TextBlock x:Name="NoticeDetail" Margin="0,2,0,0" Foreground="{ThemeResource PillSecondaryTextBrush}"
                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                       IsTextScaleFactorEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
