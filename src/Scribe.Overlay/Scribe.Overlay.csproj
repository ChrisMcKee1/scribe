<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone WinUI 3 recording pill. Built as an UNPACKAGED, SELF-CONTAINED exe so it
       ships inside the Velopack payload next to Scribe.exe with no MSIX and no dependency on a
       machine-wide Windows App SDK runtime (an unpackaged WinUI app silently fails to start if the
       runtime is missing; self-contained bundles it, ~+150 MB, but is reliable). The WPF app
       launches and keeps this process warm and drives its state over a named pipe.

       WinUI tooling requires an explicit Platform (it has no AnyCPU story), so both x64 and ARM64
       are declared and the caller selects one with -p:Platform=. RuntimeIdentifier is derived from
       Platform below so the normal build paths cannot pair an ARM64 Platform with an x64 native
       payload. An explicit -p:RuntimeIdentifier= on the command line is a global property and
       still overrides this, so pack-time payload verification remains the real guarantee. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Scribe.Overlay</RootNamespace>
    <AssemblyName>Scribe.Overlay</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Anything not ARM64 builds x64. Platforms above constrains what the SDK will accept, so this
       is the x64 branch rather than a silent catch-all for a typo'd Platform value. -->
  <PropertyGroup Condition="'$(Platform)' != 'ARM64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Windows App SDK component packages rather than the Microsoft.WindowsAppSDK metapackage: a
       self-contained build ships every referenced component's runtime, and the pill loads only WinUI,
       windowing/composition (InteractiveExperiences) and Foundation. The metapackage also brought the
       AI, ML (ONNX Runtime, DirectML), Search, Widgets and DWriteCore components. Versions and the
       reason for pinning all four live in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
  </ItemGroup>

  <!-- The pill's text-scaled geometry and the rule for when a new text scale applies are plain C# in Scribe.Core, where
       they are tested (PillGeometryTests, PillTextScaleTests). The overlay compiles those two files itself rather than
       referencing Scribe.Core, which would bring its dependencies and native payload into this process. -->
  <ItemGroup>
    <Compile Include="..\Scribe.Core\Overlay\PillGeometry.cs" Link="Shared\PillGeometry.cs" />
    <Compile Include="..\Scribe.Core\Overlay\PillTextScale.cs" Link="Shared\PillTextScale.cs" />
  </ItemGroup>

</Project>
