<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Dual-architecture: win-x64 for Intel/AMD, win-arm64 for Copilot+ PCs. PlatformTarget is
         deliberately NOT pinned so the active RuntimeIdentifier decides the architecture; a
         hardcoded x64 would silently produce an x64 assembly inside an ARM64 publish. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Scribe.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Which sherpa-onnx native runtime to bring in. The SDK sets RuntimeIdentifier to the host RID
       when no explicit -r is passed, so this is normally the machine we are building on; an explicit
       -r win-arm64 (or -r win-x64) overrides it. Resolved once here rather than repeating the
       fallback on each PackageReference, because referencing both natives at once would put two
       different-architecture DLLs with identical names in the same output folder. -->
  <PropertyGroup>
    <ScribeNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ScribeNativeRid>
    <ScribeNativeRid Condition="'$(ScribeNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</ScribeNativeRid>
    <ScribeNativeRid Condition="'$(ScribeNativeRid)' == ''">win-x64</ScribeNativeRid>
  </PropertyGroup>

  <Target Name="ScribeValidateNativeRid" BeforeTargets="ResolvePackageAssets">
    <Error Condition="'$(ScribeNativeRid)' != 'win-x64' and '$(ScribeNativeRid)' != 'win-arm64'"
           Text="Scribe supports win-x64 and win-arm64 only; the speech engine has no native runtime for '$(ScribeNativeRid)'." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Scribe.Benchmarks" />
    <InternalsVisibleTo Include="Scribe.Core.Tests" />
    <InternalsVisibleTo Include="Scribe.Evals" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in dictionary libraries: shipped inside the assembly and loaded by
         BuiltInDictionaryLibraries. The file name (without extension) is the library id. -->
    <EmbeddedResource Include="PostProcessing\Libraries\*.csv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <!-- sherpa-onnx ships its native ONNX Runtime per architecture, and both natives use the same
         file names, so exactly ONE must ever be referenced or they collide in the output folder.
         ScribeNativeRid (below) resolves that choice from the effective RID. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64"
                      Condition="'$(ScribeNativeRid)' == 'win-x64'" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64"
                      Condition="'$(ScribeNativeRid)' == 'win-arm64'" />
    <PackageReference Include="Microsoft.AI.Foundry.Local" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" />
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.ResourceManager.CognitiveServices" />
    <PackageReference Include="Azure.ResourceManager.ResourceGraph" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
