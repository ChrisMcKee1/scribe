<ui:FluentWindow x:Class="Scribe.App.QuickAdd.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add to dictionary"
        Width="560" Height="640" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="False"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock" x:Key="CardTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="CardDescription">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="Border" x:Key="CalloutBorder">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style TargetType="CheckBox" x:Key="QuickAddCheckBox">
            <Setter Property="Padding" Value="0,5,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="1"/>
                            <TextBlock x:Name="CheckGlyph"
                                       Text="✓"
                                       Visibility="Collapsed"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton" x:Key="WordChip">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip"
                                CornerRadius="5"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Add to dictionary" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/scribe-mark.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TextBlock x:Name="AnnouncementText"
                   Width="0"
                   Height="0"
                   Opacity="0"
                   IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Polite"/>

        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,8,24,16">
                <TextBlock x:Name="IntroText"
                           Style="{StaticResource CardDescription}"
                           Text="Fix words Scribe gets wrong, so it writes them your way next time."/>

                <Border x:Name="DictionaryOffNotice"
                        Style="{StaticResource CalloutBorder}"
                        Margin="0,12,0,0"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" Margin="0,2,8,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="DictionaryOffText" Grid.Column="1" Style="{StaticResource CardDescription}" Margin="0"/>
                        <ui:Button x:Name="OpenAdvancedButton" Grid.Column="2" Margin="12,0,0,0"
                                   Content="Open Advanced settings" Click="OpenAdvancedButton_Click"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="SourcePanel" Margin="0,16,0,0">
                    <TextBlock x:Name="RecentLabel" Style="{StaticResource CardTitle}" Text="Recent dictation"/>
                    <ComboBox x:Name="RecentPicker"
                              Margin="0,4,0,0"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.LabeledBy="{Binding ElementName=RecentLabel}"
                              AutomationProperties.HelpText="Choose the dictation that has the mistake."
                              SelectionChanged="RecentPicker_SelectionChanged"/>
                    <TextBlock x:Name="HintText"
                               Style="{StaticResource CardDescription}"
                               Margin="0,8,0,0"/>
                    <Border Margin="0,8,0,0"
                            MinHeight="88"
                            CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" Padding="10,10,10,6">
                            <ItemsControl x:Name="WordsList"
                                          Focusable="False"
                                          IsTabStop="False"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          AutomationProperties.Name="Words in this dictation"
                                          AutomationProperties.HelpText="Arrow keys move between words. Space selects a word. Shift and an arrow key select several."
                                          PreviewKeyDown="WordsList_PreviewKeyDown"
                                          GotKeyboardFocus="WordsList_GotKeyboardFocus"
                                          LostKeyboardFocus="WordsList_LostKeyboardFocus">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource WordChip}"
                                                      Content="{Binding Text}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Tag="{Binding Index}"
                                                      AutomationProperties.Name="{Binding Text}"
                                                      AutomationProperties.PositionInSet="{Binding PositionInSet}"
                                                      AutomationProperties.SizeOfSet="{Binding SizeOfSet}"
                                                      Focusable="True"
                                                      IsTabStop="{Binding IsFocusedChip}"
                                                      PreviewMouseLeftButtonDown="Chip_MouseDown"
                                                      MouseEnter="Chip_MouseEnter"
                                                      Checked="Chip_Toggled"
                                                      Unchecked="Chip_Toggled"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="NoTranscriptHint"
                           Style="{StaticResource CardDescription}"
                           Margin="0,16,0,0"
                           Visibility="Collapsed"
                           Text="No recent dictations to pick from. Type the words in the boxes below."/>

                <TextBlock x:Name="HeardLabel" Style="{StaticResource CardTitle}" Margin="0,16,0,0" Text="Scribe hears"/>
                <ui:TextBox x:Name="HeardBox"
                            Margin="0,4,0,0"
                            PlaceholderText="For example, cloud pilot"
                            AutomationProperties.LabeledBy="{Binding ElementName=HeardLabel}"
                            AutomationProperties.HelpText="The words as Scribe recognized them. Select words above, or type them."
                            TextChanged="Field_Changed"
                            PreviewKeyDown="TextBox_PreviewKeyDown"/>

                <TextBlock x:Name="ShouldBeLabel" Style="{StaticResource CardTitle}" Margin="0,12,0,0" Text="Scribe writes"/>
                <ui:TextBox x:Name="ShouldBeBox"
                            Margin="0,4,0,0"
                            PlaceholderText="For example, Copilot"
                            AutomationProperties.LabeledBy="{Binding ElementName=ShouldBeLabel}"
                            AutomationProperties.HelpText="What Scribe types instead."
                            TextChanged="Field_Changed"
                            PreviewKeyDown="TextBox_PreviewKeyDown"/>

                <CheckBox x:Name="RemoveBox"
                          Style="{StaticResource QuickAddCheckBox}"
                          IsThreeState="False"
                          Margin="0,12,0,0"
                          Content="Remove these words instead"
                          AutomationProperties.HelpText="Scribe types nothing where it hears these words."
                          Checked="Field_Changed"
                          Unchecked="Field_Changed"/>
                <CheckBox x:Name="WholeWordBox"
                          Style="{StaticResource QuickAddCheckBox}"
                          IsThreeState="False"
                          Margin="0,8,0,0"
                          IsChecked="True"
                          Content="Whole words only"
                          AutomationProperties.HelpText="Off lets Scribe replace text inside longer words, like &quot;net&quot; inside &quot;network&quot;."
                          Checked="Field_Changed"
                          Unchecked="Field_Changed"/>
                <TextBlock x:Name="WholeWordDescription"
                           Style="{StaticResource CardDescription}"
                           Margin="28,2,0,0"
                           Text="Off lets Scribe replace text inside longer words, like &quot;net&quot; inside &quot;network&quot;."/>

                <Grid x:Name="StatusRow" MinHeight="32" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="StatusIcon" FontSize="16" Margin="0,2,8,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource CardDescription}" Margin="0"/>
                    <ui:Button x:Name="StatusActionButton" Grid.Column="2" Margin="12,0,0,0" Visibility="Collapsed" Click="StatusActionButton_Click"/>
                </Grid>

                <TextBlock x:Name="SavedDetailText"
                           Style="{StaticResource CardDescription}"
                           Margin="24,4,0,0"
                           Visibility="Collapsed"
                           Text="Text you already typed doesn't change. To replace it, copy the fixed dictation and paste it."/>
                <ui:Button x:Name="CopyFixedButton"
                           HorizontalAlignment="Right"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"
                           Content="Copy fixed dictation"
                           Click="CopyFixedButton_Click"/>

                <TextBlock x:Name="AiVocabularyText"
                           Style="{StaticResource CardDescription}"
                           Margin="0,16,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12,24,18">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button x:Name="SaveButton" Content="_Save" Appearance="Primary" MinWidth="96"
                           KeyboardNavigation.AcceptsReturn="False"
                           Margin="0,0,8,8" Click="SaveButton_Click"/>
                <ui:Button x:Name="SaveCloseButton" Content="Save _and close" MinWidth="132"
                           KeyboardNavigation.AcceptsReturn="False"
                           Margin="0,0,8,8" Click="SaveCloseButton_Click"/>
                <ui:Button x:Name="CloseButton" Content="_Close" MinWidth="96" Margin="0,0,0,8"
                           Click="CloseButton_Click"/>
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>




