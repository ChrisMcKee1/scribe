<ui:FluentWindow x:Class="Scribe.App.Settings.DictionaryWordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add word"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontSize="{DynamicResource ScribeFontBody}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ui:FluentWindow.Resources>
        <Style x:Key="FieldTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource ScribeFontBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource ScribeFontCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="WordTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="{DynamicResource ScribeFontBody}"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="DialogTitleBar" Title="Add word">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Scribe;component/Assets/scribe-mark.png"
                              Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="24,8,24,0" Focusable="False">
            <StackPanel>
                <TextBlock x:Name="WrittenTitle" Text="Scribe writes" Style="{StaticResource FieldTitle}"/>
                <TextBox x:Name="WrittenBox" Margin="0,8,0,0" Style="{StaticResource WordTextBox}"
                         AutomationProperties.LabeledBy="{Binding ElementName=WrittenTitle}"/>
                <TextBlock Text="Leave empty to remove what Scribe hears." Style="{StaticResource FieldHelp}" Margin="0,6,0,0"/>
                <TextBlock Text="Scribe hears" Style="{StaticResource FieldTitle}" Margin="0,20,0,0"/>
                <TextBlock Text="Each box is one way. Spaces and commas stay part of that way."
                           Style="{StaticResource FieldHelp}" Margin="0,6,0,8"/>
                <StackPanel x:Name="FormsPanel"/>
                <ui:Button x:Name="AddWayButton" Content="Add another way" Icon="{ui:SymbolIcon Add24}"
                           HorizontalAlignment="Left" Margin="0,4,0,0" Click="AddWayButton_Click"/>
                <TextBlock x:Name="RuleStatusText" Style="{StaticResource FieldHelp}" Margin="0,12,0,0"/>
                <TextBlock Text="New ways are on and match whole words only. You can change either in the list."
                           Style="{StaticResource FieldHelp}" Margin="0,8,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="24,12,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="ErrorText" Style="{StaticResource FieldTitle}" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="1" Text="Changes take effect when you save Settings." Style="{StaticResource FieldHelp}" Margin="0,0,0,10"/>
            <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                <ui:Button x:Name="AcceptButton" Content="Add" Appearance="Primary" MinWidth="100"
                           Margin="0,0,8,4" Click="AcceptButton_Click" ToolTip="Add to the settings draft (Ctrl+Enter)."/>
                <ui:Button Content="Cancel" MinWidth="100" Margin="0,0,0,4" Click="CancelButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
