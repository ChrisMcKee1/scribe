<ui:FluentWindow x:Class="Scribe.App.Settings.DictionaryCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Clean up unused terms"
        Width="660" Height="680" MinWidth="580" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="2,14,0,6"/>
        </Style>

        <DataTemplate x:Key="CleanupRowTemplate">
            <Border Margin="0,0,0,4" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                          VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13"/>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                   FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </CheckBox>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Clean up unused terms">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Broom24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <TextBlock x:Name="SummaryText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <CheckBox x:Name="SelectAllBox"
                      Margin="0,12,0,0"
                      IsChecked="True"
                      IsThreeState="True"
                      Content="Select everything"
                      Click="SelectAll_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EntriesHeader" Style="{StaticResource SectionLabel}"
                           Text="YOUR ENTRIES"/>
                <ItemsControl x:Name="EntriesList"
                              ItemTemplate="{StaticResource CleanupRowTemplate}"/>

                <TextBlock x:Name="LibrariesHeader" Style="{StaticResource SectionLabel}"
                           Text="LIBRARIES WITH TERMS THAT DID NOT COME UP"/>
                <ItemsControl x:Name="LibrariesList"
                              ItemTemplate="{StaticResource CleanupRowTemplate}"/>

                <TextBlock x:Name="FootnoteText"
                           Margin="2,14,0,10" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="24,10,24,18">
            <ui:Button Content="Cancel" MinWidth="100" Margin="0,0,8,0" IsCancel="True"
                       Click="CancelButton_Click"/>
            <ui:Button x:Name="DeleteButton" Content="Delete selected entries" MinWidth="170"
                       Margin="0,0,8,0"
                       Appearance="Danger" Click="DeleteButton_Click"
                       ToolTip="Remove the ticked entries from your dictionary for good. Libraries are switched off either way; their terms are not yours to delete."/>
            <ui:Button x:Name="DisableButton" Content="Turn off selected" Appearance="Primary"
                       MinWidth="150" Click="DisableButton_Click"
                       ToolTip="Keep the ticked entries but stop them applying. You can switch them back on any time."/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
