<ui:FluentWindow x:Class="Scribe.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:cleanup="clr-namespace:Scribe.Core.Cleanup;assembly=Scribe.Core"
        xmlns:infra="clr-namespace:Scribe.App.Infrastructure"
        xmlns:models="clr-namespace:Scribe.Core.Models;assembly=Scribe.Core"
        xmlns:settings="clr-namespace:Scribe.App.Settings"
        Title="Scribe Settings"
        Width="1240" Height="900" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        PreviewKeyDown="HotkeyBox_PreviewKeyDown"
        PreviewKeyUp="HotkeyBox_PreviewKeyUp"
        PreviewMouseDown="HotkeyCapture_PreviewMouseDown"
        PreviewMouseUp="HotkeyCapture_PreviewMouseUp"
        Deactivated="SettingsWindow_Deactivated_StopHotkeyCapture">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="HistoryThumbButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="PageTitle">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="PageSubtitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="MaxWidth" Value="720"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="1,24,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="CardTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="RailLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="CardDescription">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="StatusText" BasedOn="{StaticResource CardDescription}"/>
        <Style TargetType="TextBlock" x:Key="TryDictationResultLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="TryDictationResultText">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="MetricValue">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="MetricLabel" BasedOn="{StaticResource CardDescription}"/>
        <Style TargetType="TextBlock" x:Key="DetailTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="PathText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- A check box row's box sits on the card's content edge, and the 28 DIP description indent (the box's 20 plus
             WPF-UI's 8 DIP content margin) lines up with the title; WPF-UI's default 11 DIP left padding offset both. -->
        <Style TargetType="CheckBox" x:Key="SettingCheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Padding" Value="0,5,0,6"/>
        </Style>
        <Style TargetType="ui:Card" x:Key="SettingsCard" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <Style TargetType="ui:Card" x:Key="PanelCard" BasedOn="{StaticResource SettingsCard}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
        </Style>
        <Style TargetType="ui:Card" x:Key="EditorPanelCard" BasedOn="{StaticResource PanelCard}">
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style TargetType="Border" x:Key="CalloutBorder">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- WPF-UI 4.3.0 writes every badge in its text-on-accent colour, white in the light theme and black in the
             dark one, whatever the badge's own fill, so the light theme drew the coverage badges white on the
             palette's orange (2.16:1) and light blue (2.63:1). In a light or dark theme each palette fill takes the
             foreground AccentContrastResources chose for it; a badge on the accent keeps WPF-UI's, and in a contrast
             theme the flag is off and every badge draws the theme's own. -->
        <Style TargetType="ui:Badge" BasedOn="{StaticResource {x:Type ui:Badge}}">
            <Setter Property="infra:AccentContrastFlag.Applies" Value="{DynamicResource {x:Static infra:AccentContrastKeys.Applies}}"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                        <Condition Property="Appearance" Value="Caution"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static infra:AccentContrastKeys.CautionBadgeForeground}}"/>
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                        <Condition Property="Appearance" Value="Info"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static infra:AccentContrastKeys.InfoBadgeForeground}}"/>
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                        <Condition Property="Appearance" Value="Danger"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static infra:AccentContrastKeys.DangerBadgeForeground}}"/>
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                        <Condition Property="Appearance" Value="Success"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static infra:AccentContrastKeys.SuccessBadgeForeground}}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="infra:AccentContrastFlag.Applies" Value="{DynamicResource {x:Static infra:AccentContrastKeys.Applies}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Border"
                                    Margin="0"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4">
                                <Grid>
                                    <Rectangle x:Name="SelectionIndicator"
                                               Width="3" Height="16" Margin="0,0,8,0"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource {x:Static infra:AccentContrastKeys.SelectedItemIndicator}}"
                                               Visibility="Collapsed"/>
                                    <ContentPresenter Margin="11,0,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ListBoxItemSelectedBackgroundThemeBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ListBoxItemSelectedForegroundThemeBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static infra:AccentContrastKeys.SelectedItemForeground}}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Check boxes in the editable grids. Outside edit mode a check box cell shows a box that takes
             neither the mouse nor focus, as WPF's and WPF-UI's own column styles do, and toggling it is
             left to the column's edit. The grid's own click handling still focuses and selects on every
             press; DataGridCheckBoxClick then turns a plain press on the box into that edit, so one click
             toggles it inside the row's edit transaction, and Space on the focused cell still toggles
             through the same edit. The Editing styles are the same box while the cell edits, focusable
             and clickable. Based on the WPF-UI check box so they match the rest of the app. -->
        <Style x:Key="GridCheckBoxEditing" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LibraryOnCheckBoxEditing" TargetType="CheckBox" BasedOn="{StaticResource GridCheckBoxEditing}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat='Use the {0} word pack'}"/>
        </Style>
        <Style x:Key="LibraryOnCheckBox" TargetType="CheckBox" BasedOn="{StaticResource LibraryOnCheckBoxEditing}">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="WholeWordCheckBoxEditing" TargetType="CheckBox" BasedOn="{StaticResource GridCheckBoxEditing}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Pattern, StringFormat='Whole word for {0}'}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pattern}" Value="">
                    <Setter Property="AutomationProperties.Name" Value="Whole word for the new entry"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WholeWordCheckBox" TargetType="CheckBox" BasedOn="{StaticResource WholeWordCheckBoxEditing}">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="EntryEnabledCheckBoxEditing" TargetType="CheckBox" BasedOn="{StaticResource GridCheckBoxEditing}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Pattern, StringFormat='Enabled for {0}'}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pattern}" Value="">
                    <Setter Property="AutomationProperties.Name" Value="Enabled for the new entry"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EntryEnabledCheckBox" TargetType="CheckBox" BasedOn="{StaticResource EntryEnabledCheckBoxEditing}">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- Every grid on these pages is one Tab stop whose cells the arrow keys move between, as in a Windows
             list. WPF-UI's cell style (DefaultDataGridCellStyle, DataGrid.xaml in WPF-UI 4.3.0) makes no cell a
             Tab stop, so a grid of text had no Tab stop at all (the Word packs, History, Usage and Diagnostics
             grids could not be reached from the keyboard, and after Space on a check box the arrow keys had no
             cell to move to), while a grid whose cells hold buttons put every row's button in the Tab order.
             Cells take focus again, and TabNavigation Once enters a grid on the cell that last had focus (the
             first cell before that) and leaves it on the next Tab. WPF's row panel, DataGridCellsPanel, is a
             Local navigation group of its own, which would still walk Tab along the row and keep the grid from
             remembering its cell, so the rows lay their cells out in one that continues to the grid instead. A
             cell navigates its own content locally, so Tab from a cell that holds a button reaches the button
             first.

             Watch out: a grid's own RowStyle, or a grid's or a column's own CellStyle, silently replaces
             KeyboardRow or KeyboardCell, and the grid quietly loses this keyboard behaviour. Base such a style on
             KeyboardRow or KeyboardCell instead. -->
        <Style x:Key="KeyboardCell" TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
            <Setter Property="IsTabStop" Value="True"/>
        </Style>
        <Style x:Key="KeyboardRow" TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <DataGridCellsPanel KeyboardNavigation.TabNavigation="Continue"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
            <Setter Property="CellStyle" Value="{StaticResource KeyboardCell}"/>
            <Setter Property="RowStyle" Value="{StaticResource KeyboardRow}"/>
        </Style>

        <!-- A word pack row. The selected word pack is the one the page's edits apply to, and WPF-UI marks it only with a
             subtle fill (1.18:1 against the page in the dark theme) and a 3 px accent pill (1.63:1 against that fill
             with the accent #0E0E70), so it also gets a 1 DIP outline in the strong control stroke and a SemiBold
             name, whatever the accent. Drawn over the selected fill the stroke measures 5.27:1 against that fill and
             6.23:1 against the page in the dark theme, 3.19:1 and 3.46:1 in the light one. Both cues are overlays,
             and so is the pill here, drawn over the first cell's padding instead of in a column of its own: selecting
             a row moves no cell, and no longer makes the row wider than the list (WPF-UI's column for the pill added
             a horizontal scroll bar under it). AccentContrastResources supplies the outline and the weight, and
             leaves both off in contrast themes. Otherwise WPF-UI 4.3.0's DefaultDataGridRowStyle template, less its
             empty visual states, and based on KeyboardRow as the note above requires. -->
        <Style x:Key="LibraryRow" TargetType="DataGridRow" BasedOn="{StaticResource KeyboardRow}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <SelectiveScrollingGrid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </SelectiveScrollingGrid.RowDefinitions>
                                    <DataGridCellsPresenter Grid.Column="1"
                                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <DataGridDetailsPresenter Grid.Row="1" Grid.Column="1"
                                                              SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                              Visibility="{TemplateBinding DetailsVisibility}"/>
                                    <DataGridRowHeader Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                       SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                                       Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                    <Rectangle x:Name="ActiveRectangle" Grid.Row="0" Grid.Column="1"
                                               Width="3" Height="18" Margin="1,0,0,0"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Fill="{DynamicResource ListViewItemPillFillBrush}"
                                               RadiusX="2" RadiusY="2" IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </SelectiveScrollingGrid>
                                <Border x:Name="SelectionOutline" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="AlternationIndex" Value="0">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{Binding RowBackground, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                            </Trigger>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{Binding AlternatingRowBackground, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                                <Setter TargetName="SelectionOutline" Property="BorderBrush" Value="{DynamicResource {x:Static infra:AccentContrastKeys.SelectedRowOutline}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The selected word pack's name, SemiBold with the row's outline (see LibraryRow). Only the name line of the name
             cell: its source line and the other columns stay as they are, because the other columns size to their
             content and a wider SemiBold value there would move them. The name sits in the cell template's panel, which
             gives it the 2 px margin a text column's text gets, so the style adds no margin of its own. -->
        <Style x:Key="LibraryNameText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                    <Setter Property="FontWeight" Value="{DynamicResource {x:Static infra:AccentContrastKeys.SelectedRowNameWeight}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The word packs list's name cell shows the name over its source ("Built-in" or "Your word pack"). A template cell
             has no text of its own, so UI Automation would read it as "Item: GitHub, Column Display Index: 1"; it is named
             after both lines instead. Based on KeyboardCell, as the warning above requires. -->
        <Style x:Key="LibraryNameCell" TargetType="DataGridCell" BasedOn="{StaticResource KeyboardCell}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
        </Style>

        <!-- The remove button in a Dictionary row is only an icon, so it is named after the entry it removes. -->
        <Style x:Key="DictionaryRemoveButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Pattern, StringFormat='Remove {0}'}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pattern}" Value="">
                    <Setter Property="AutomationProperties.Name" Value="Remove the new entry"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A CardExpander opens and closes from a toggle button inside WPF-UI's template whose content is a panel,
             so a screen reader announced it with no name at all. WPF's ExpanderAutomationPeer speaks for that toggle
             only when the template calls it HeaderSite (Expander.cs, ExpanderAutomationPeer.cs), and WPF-UI 4.3.0
             calls it ExpanderToggleButton, so the toggle is labelled by whatever labels its expander. -->
        <Style TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Style.Resources>
                <Style TargetType="ToggleButton">
                    <Setter Property="AutomationProperties.LabeledBy"
                            Value="{Binding (AutomationProperties.LabeledBy), RelativeSource={RelativeSource TemplatedParent}}"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- One clickable zone of the overlay-position picker. The radio button keeps the existing focus and
             selection behaviour while the visual reads as a miniature recording indicator. Brand fills are
             used only while AccentContrastResources is active; contrast themes fall back to system colours. -->
        <Style TargetType="RadioButton" x:Key="OverlayZone">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="infra:AccentContrastFlag.Applies" Value="{DynamicResource {x:Static infra:AccentContrastKeys.Applies}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Cell" Background="Transparent">
                            <Border x:Name="Pill" Width="48" Height="16" CornerRadius="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                    BorderThickness="1">
                                <StackPanel x:Name="LevelBars" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <Rectangle x:Name="LevelBar1" Width="2" Height="6" RadiusX="1" RadiusY="1"
                                               Margin="0,0,3,0" Fill="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                    <Rectangle x:Name="LevelBar2" Width="2" Height="10" RadiusX="1" RadiusY="1"
                                               Margin="0,0,3,0" Fill="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                    <Rectangle x:Name="LevelBar3" Width="2" Height="6" RadiusX="1" RadiusY="1"
                                               Fill="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="Pill" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                <Setter TargetName="Pill" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="LevelBars" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ScribePillFaceBrush}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ScribePillListeningEdgeBrush}"/>
                                <Setter TargetName="LevelBar1" Property="Fill" Value="{DynamicResource ScribeLevelTipBrush}"/>
                                <Setter TargetName="LevelBar2" Property="Fill" Value="{DynamicResource ScribeLevelTipBrush}"/>
                                <Setter TargetName="LevelBar3" Property="Fill" Value="{DynamicResource ScribeLevelTipBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Scribe Settings">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/scribe-mark.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left navigation rail. A ListBox is one Tab stop and the arrow keys move along it. Each item
                 names itself for screen readers: an item that holds a panel instead of text is otherwise
                 announced by its type name, "System.Windows.Controls.ListBoxItem". -->
            <ListBox x:Name="NavList" Grid.Column="0" Margin="8,4,4,16"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Settings pages"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBox.Resources>
                    <Style TargetType="ui:SymbolIcon">
                        <Setter Property="infra:AccentContrastFlag.Applies" Value="{DynamicResource {x:Static infra:AccentContrastKeys.Applies}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Filled" Value="True"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                    <Condition Binding="{Binding Path=(infra:AccentContrastFlag.Applies), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static infra:AccentContrastKeys.SelectedItemIndicator}}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20"/>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource RailLabel}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Margin" Value="4,1"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                        <Setter Property="AutomationProperties.PositionInSet" Value="{Binding Position}"/>
                        <Setter Property="AutomationProperties.SizeOfSet" Value="11"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="12,16,0,4" IsHitTestVisible="False" Focusable="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <!-- Right: the selected section + a persistent Save/Cancel footer -->
            <Grid Grid.Column="1" Margin="12,4,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Shared inline notification; any section can raise it via ShowInfo(...). Floats over
                     the content at the top so it never shifts the section layout. -->
                <ui:InfoBar x:Name="InfoNotice" Grid.Row="0" Panel.ZIndex="1"
                            VerticalAlignment="Top" Margin="2,4,2,0"
                            IsClosable="True" IsOpen="False">
                    <!-- WPF-UI 4.3.0 draws the close button as an icon-only Wpf.Ui Button in the bar's template
                         (CloseButton in InfoBar.xaml), the only one there, so it is named from here. -->
                    <ui:InfoBar.Resources>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="AutomationProperties.Name" Value="Close notification"/>
                        </Style>
                    </ui:InfoBar.Resources>
                </ui:InfoBar>

                <Grid Grid.Row="0">

                    <!-- ============================ General ============================ -->
                    <Grid x:Name="SectionDictation">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,16" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock Text="Dictation" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Your microphone, your shortcuts, and what you see while you dictate."/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,0,14,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1000"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                <StackPanel x:Name="FirstRunHintHost" Visibility="Collapsed" Margin="0,0,0,12">
                                    <ui:InfoBar x:Name="FirstRunHintBar" Title="Ready to dictate" Message="Click in any text box, hold Page Down and speak. Let go to type." IsOpen="False" Severity="Informational" IsClosable="False"/>
                                    <ui:Button Content="Try it here" Margin="0,8,0,0" HorizontalAlignment="Left" Click="TryDictationLink_Click"/>
                                </StackPanel>

                                <TextBlock Text="Microphone" Style="{StaticResource SectionHeader}" Margin="1,4,0,8"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Microphone" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Windows default follows the microphone you choose in Windows sound settings."/>
                                        <ComboBox x:Name="DeviceCombo" DisplayMemberPath="Label"
                                                  AutomationProperties.Name="Microphone"
                                                  SelectionChanged="DeviceCombo_SelectionChanged"
                                                  DropDownClosed="DeviceCombo_DropDownClosed"
                                                  Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <ui:Button Content="Sound settings" HorizontalAlignment="Left" Click="SoundSettings_Click"/>
                                            <ui:Button Content="Try dictation" HorizontalAlignment="Left" Margin="8,0,0,0" Click="TryDictationLink_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>

                                <TextBlock Text="Shortcuts" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="HotkeyTitle" Text="Dictation shortcut" Style="{StaticResource CardTitle}"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="HotkeyBox" Grid.Column="0" Width="200" IsReadOnly="True"
                                                        VerticalContentAlignment="Center"
                                                        PlaceholderText="Choose Change, then press a key, two keys or a mouse button"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=HotkeyTitle}"/>
                                            <ui:Button x:Name="CaptureButton" Grid.Column="1" Content="Change"
                                                       Margin="8,0,0,0" MinWidth="72"
                                                       Click="CaptureButton_Click"/>
                                            <ComboBox x:Name="ModeCombo" Grid.Column="2" Width="210" Margin="8,0,0,0"
                                                      SelectionChanged="ShortcutModeCombo_SelectionChanged"
                                                      VerticalContentAlignment="Center"
                                                      AutomationProperties.Name="Dictation shortcut, hold or toggle"/>
                                        </Grid>
                                        <TextBlock x:Name="HotkeyDescriptionText" Style="{StaticResource CardDescription}"
                                                   Text="Types your words with AI cleanup."/>
                                        <TextBlock x:Name="HotkeyCaveatText" Style="{StaticResource CardDescription}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="DictationOnlyTitle" Text="Shortcut without AI cleanup" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="DictationOnlyHotkeyBox" Grid.Column="0" Width="200" IsReadOnly="True"
                                                        VerticalContentAlignment="Center"
                                                        PlaceholderText="None"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=DictationOnlyTitle}"/>
                                            <ui:Button Grid.Column="1" Content="Change" Margin="8,0,0,0" MinWidth="72"
                                                       Click="DictationOnlyCaptureButton_Click"/>
                                            <ui:Button x:Name="DictationOnlyClearButton" Grid.Column="2" Content="Remove" Margin="8,0,0,0" MinWidth="72"
                                                       Click="DictationOnlyClearButton_Click"/>
                                            <ComboBox x:Name="DictationOnlyModeCombo" Grid.Column="3" Width="210" Margin="8,0,0,0"
                                                      SelectionChanged="ShortcutModeCombo_SelectionChanged"
                                                      VerticalContentAlignment="Center"
                                                      AutomationProperties.Name="Shortcut without AI cleanup, hold or toggle"/>
                                        </Grid>
                                        <TextBlock x:Name="DictationOnlyDescriptionText" Style="{StaticResource CardDescription}"
                                                   Text="Optional. Types exactly what Scribe hears, with your dictionary and snippets."/>
                                        <TextBlock x:Name="DictationOnlyCaveatText" Style="{StaticResource CardDescription}" Visibility="Collapsed"/>
                                        <!-- Text comes from HotkeyCaptureSession.MouseButtonsHint: which buttons, how to set one,
                                             and what binding one costs in other apps. -->
                                        <TextBlock x:Name="MouseButtonsHintText" Style="{StaticResource CardDescription}"
                                                   Visibility="Collapsed"/>
                                        <!-- Text comes from DefaultHotkeyRestore.Hint so it names the keys the button
                                             actually restores, and what binding them costs in other apps. -->
                                        <TextBlock x:Name="DefaultHotkeysHintText" Style="{StaticResource CardDescription}"
                                                   Margin="0,16,0,0"/>
                                        <ui:Button x:Name="RestoreHotkeysButton" Content="Restore default shortcuts"
                                                   Margin="0,10,0,0" HorizontalAlignment="Left" Appearance="Secondary"
                                                   AutomationProperties.HelpText="{Binding Text, ElementName=DefaultHotkeysHintText}"
                                                   Click="RestoreHotkeysButton_Click"/>
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="AutoStopCheck" Style="{StaticResource SettingCheckBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=AutoStopTitle}"
                                                  AutomationProperties.HelpText="{Binding Text, ElementName=AutoStopDescription}">
                                                <TextBlock x:Name="AutoStopTitle" Text="Stop when I stop talking" Style="{StaticResource CardTitle}"/>
                                        </CheckBox>
                                        <TextBlock Margin="28,2,0,0" x:Name="AutoStopDescription" Style="{StaticResource CardDescription}" Text="Scribe stops after a few seconds of silence. A noisy room can stop it early."/>
                                    </StackPanel>
                                </ui:Card>

                                <TextBlock Text="Typing" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="SpaceAfterDictationCheck" Style="{StaticResource SettingCheckBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=SpaceAfterDictationTitle}"
                                                  AutomationProperties.HelpText="{Binding Text, ElementName=SpaceAfterDictationHint}">
                                                <TextBlock x:Name="SpaceAfterDictationTitle" Text="Add a space after each dictation" Style="{StaticResource CardTitle}"/>
                                        </CheckBox>
                                        <TextBlock Margin="28,2,0,0" x:Name="SpaceAfterDictationHint" Style="{StaticResource CardDescription}" Text="Makes back-to-back dictations flow. Turn it off if an app needs text without a trailing space."/>
                                        <ui:Button Content="More typing options are on the Advanced page." Margin="28,8,0,0" HorizontalAlignment="Left" Click="AdvancedTypingLink_Click"/>
                                    </StackPanel>
                                </ui:Card>

                                <TextBlock Text="Recording indicator" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="OverlayCheck" Style="{StaticResource SettingCheckBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=OverlayTitle}"
                                                  AutomationProperties.HelpText="{Binding Text, ElementName=OverlayDescription}">
                                                <TextBlock x:Name="OverlayTitle" Text="Show the recording indicator" Style="{StaticResource CardTitle}"/>
                                        </CheckBox>
                                        <TextBlock Margin="28,2,0,0" x:Name="OverlayDescription" Style="{StaticResource CardDescription}" Text="A small bar with a live sound level appears while Scribe listens."/>
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Where it appears" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Choose a spot, then preview it on your screen."/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Mini monitor: a 16:9 screen mock-up with nine clickable
                                                 anchor zones and a taskbar strip for orientation. Each zone
                                                 stays a Tab stop of its own, in reading order, rather than one
                                                 stop for the group: an arrow key cannot move focus between the
                                                 zones, because the page's scroll viewer takes it and only
                                                 scrolls. WPF moves focus on an arrow key only through a
                                                 PART_ScrollContentPresenter, which WPF-UI 4.3.0's ScrollViewer
                                                 template does not name. -->
                                            <Border Grid.Column="0" Width="300" Height="170" CornerRadius="8"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <UniformGrid x:Name="OverlayPositionGrid" Grid.Row="0"
                                                                 Rows="3" Columns="3" Margin="4">
                                                        <RadioButton Style="{StaticResource OverlayZone}" Tag="TopLeft"
                                                                     ToolTip="Top left"/>
                                                        <RadioButton Style="{StaticResource OverlayZone}" Tag="TopCenter"
                                                                     ToolTip="Top center"/>
                                                        <RadioButton Style="{StaticResource OverlayZone}" Tag="TopRight"
                                                                     ToolTip="Top right"/>
                                                        <RadioButton Style="{StaticResource OverlayZone}" Tag="MiddleLeft"
                                                                     ToolTip="Middle left"/>
                                                        <RadioButton Style="{StaticResource OverlayZone}" Tag="Center"
                                                                     ToolTip="Center"/>
                                                        <RadioButton Style="{StaticResource OverlayZone}" Tag="MiddleRight"
                                                                     ToolTip="Middle right"/>
                                                        <RadioButton Style="{StaticResource OverlayZone}" Tag="BottomLeft"
                                                                     ToolTip="Bottom left"/>
                                                        <RadioButton Style="{StaticResource OverlayZone}" Tag="BottomCenter"
                                                                     ToolTip="Bottom center (default)"/>
                                                        <RadioButton Style="{StaticResource OverlayZone}" Tag="BottomRight"
                                                                     ToolTip="Bottom right"/>
                                                    </UniformGrid>
                                                    <Border Grid.Row="1" Height="9" Margin="2,0,2,2" CornerRadius="0,0,5,5"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            IsHitTestVisible="False"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                                <ui:Button x:Name="OverlayPreviewButton" Content="Preview on screen"
                                                           Icon="{ui:SymbolIcon Eye24}"
                                                           Click="OverlayPreviewButton_Click"/>
                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,8,0,0"
                                                           Text="Selected: Bottom center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <TextBlock Text="Startup" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Start Scribe when you sign in to Windows" Style="{StaticResource CardTitle}"/>
                                            <TextBlock x:Name="LaunchStatusText" Style="{StaticResource CardDescription}"
                                                       Text="Checking the Windows startup setting..."/>
                                            <ui:Button Content="Windows startup settings"
                                                       HorizontalAlignment="Left" Margin="0,8,0,0"
                                                       Click="StartupSettings_Click"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <ui:ToggleSwitch x:Name="LaunchCheck" HorizontalAlignment="Right"
                                                             IsEnabled="False" AutomationProperties.Name="Start with Windows"
                                                             AutomationProperties.HelpText="{Binding Text, ElementName=LaunchStatusText}"
                                                             Checked="LaunchCheck_Changed" Unchecked="LaunchCheck_Changed"/>
                                            <!-- Every other switch on this page waits for Save; this one does not. -->
                                            <TextBlock Text="Applies immediately." Style="{StaticResource CardDescription}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================ Dictation ============================ -->
                    <Grid x:Name="SectionAdvanced" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,16" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock Text="Advanced" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Settings most people never need to change. The defaults suit most PCs."/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,0,14,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1000"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                <TextBlock x:Name="AdvancedSpeechHeader" Text="Speech recognition" Style="{StaticResource SectionHeader}" Margin="1,4,0,8"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="TranscriptionModelTitle" Text="Speech model" Style="{StaticResource CardTitle}"/>
                                        <ComboBox x:Name="TranscriptionModelCombo" Margin="0,10,0,0"
                                                  Width="320" HorizontalAlignment="Left"
                                                  DisplayMemberPath="Label"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=TranscriptionModelTitle}"
                                                  SelectionChanged="TranscriptionModelCombo_SelectionChanged">
                                            <!-- DisplayMemberPath only controls what is drawn; UI Automation falls
                                                 back to ToString(), which on this Core record dumps every field. -->
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                        <TextBlock x:Name="TranscriptionModelHint" Style="{StaticResource CardDescription}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <ui:Button x:Name="TranscriptionModelInstallButton" Content="Download"
                                                       MinWidth="90" Click="TranscriptionModelInstallButton_Click"/>
                                            <ProgressBar x:Name="TranscriptionModelProgress" Width="220" Height="8"
                                                         Margin="12,0,0,0" VerticalAlignment="Center"
                                                         Minimum="0" Maximum="100" Visibility="Collapsed"
                                                         AutomationProperties.Name="Speech model download progress"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Processor threads" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Style="{StaticResource CardDescription}"
                                                       Text="How many processor threads speech recognition uses. Automatic suits most PCs."/>
                                        </StackPanel>
                                        <ComboBox x:Name="ThreadsCombo" Grid.Column="1" Width="240"
                                                  DisplayMemberPath="Label"
                                                  AutomationProperties.Name="Processor threads"/>
                                    </Grid>
                                </ui:Card>

                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Free memory when Scribe isn't used" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Style="{StaticResource CardDescription}"
                                                       Text="Unloads the speech model after this long without a dictation, freeing memory. The next dictation takes a second or two longer to start."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="IdleReleaseCombo" Width="240" DisplayMemberPath="Label"
                                                      SelectionChanged="DurationCombo_SelectionChanged"
                                                      AutomationProperties.Name="Free memory when Scribe isn't used"/>
                                            <ui:NumberBox x:Name="IdleReleaseCustomBox" Width="96" Margin="8,0,0,0"
                                                          SmallChange="1"
                                                          MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                                          SpinButtonPlacementMode="Inline"
                                                          Visibility="Collapsed"
                                                          AutomationProperties.Name="Free memory custom minutes"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                                <TextBlock x:Name="AdvancedSpeechCaptionText" Style="{StaticResource CardDescription}" Margin="0,6,0,0" Text="Changes to the speech model and processor threads take effect after you restart Scribe."/>
                                <TextBlock x:Name="AdvancedRecordingHeader" Text="Recording" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="VadCheck" Style="{StaticResource SettingCheckBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=VadTitle}"
                                                  AutomationProperties.HelpText="{Binding Text, ElementName=VadDescription}">
                                                <TextBlock x:Name="VadTitle" Text="Trim silence" Style="{StaticResource CardTitle}"/>
                                        </CheckBox>
                                        <TextBlock Margin="28,2,0,0" x:Name="VadDescription" Style="{StaticResource CardDescription}" Text="Removes silence at the start and end of a recording, and skips recordings with no speech."/>
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Longest recording" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Style="{StaticResource CardDescription}"
                                                       Text="A recording stops at this length and Scribe types what it heard, so a stuck key cannot record forever."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="MaxDictationCombo" Width="240" DisplayMemberPath="Label"
                                                      SelectionChanged="DurationCombo_SelectionChanged"
                                                      AutomationProperties.Name="Longest recording"/>
                                            <ui:NumberBox x:Name="MaxDictationCustomBox" Width="96" Margin="8,0,0,0"
                                                          SmallChange="1"
                                                          MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                                          SpinButtonPlacementMode="Inline"
                                                          Visibility="Collapsed"
                                                          AutomationProperties.Name="Longest recording custom minutes"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <TextBlock x:Name="AdvancedTypingHeader" Text="Typing into apps" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="InjectionTitle" Text="Typing method" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Typing works in almost every app and doesn't use your clipboard. Pasting is faster for long text: Scribe uses the clipboard for a moment and puts back what you had copied when it can. Some apps block pasting."/>
                                        <ComboBox x:Name="InjectionCombo" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=InjectionTitle}"/>
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="NewlineTitle" Text="Line breaks" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="In command windows such as Terminal, a line break works like Enter and can send text early."/>
                                        <ComboBox x:Name="NewlineCombo" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=NewlineTitle}"/>
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="ShiftEnterCheck" Style="{StaticResource SettingCheckBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=ShiftEnterTitle}"
                                                  AutomationProperties.HelpText="{Binding Text, ElementName=ShiftEnterDescription}">
                                                <TextBlock x:Name="ShiftEnterTitle" Text="Don't send chat messages early" Style="{StaticResource CardTitle}"/>
                                        </CheckBox>
                                        <TextBlock Margin="28,2,0,0" x:Name="ShiftEnterDescription" Style="{StaticResource CardDescription}" Text="Types line breaks as Shift+Enter, so apps like Teams and Slack start a new line instead of sending. Turn it off if an app uses Shift+Enter for something else."/>
                                    </StackPanel>
                                </ui:Card>

                                <TextBlock x:Name="AdvancedTextChangesHeader" Text="Text changes" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="PostCheck" Style="{StaticResource SettingCheckBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=PostTitle}"
                                                  AutomationProperties.HelpText="{Binding Text, ElementName=PostDescription}"
                                                  Checked="PostCheck_Toggled" Unchecked="PostCheck_Toggled">
                                                <TextBlock x:Name="PostTitle" Text="Apply your dictionary and snippets" Style="{StaticResource CardTitle}"/>
                                        </CheckBox>
                                        <TextBlock Margin="28,2,0,0" x:Name="PostDescription" Style="{StaticResource CardDescription}" Text="Applies your dictionary, snippets and spacing fixes to what Scribe hears. AI cleanup still receives your vocabulary when this is off."/>
                                    </StackPanel>
                                </ui:Card>

                                <TextBlock x:Name="AdvancedAppearanceHeader" Text="Appearance" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="AccentSourceCheck" Style="{StaticResource SettingCheckBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=AccentSourceTitle}"
                                                  AutomationProperties.HelpText="{Binding Text, ElementName=AccentSourceDescription}">
                                            <TextBlock x:Name="AccentSourceTitle" Text="Use my Windows accent color" Style="{StaticResource CardTitle}"/>
                                        </CheckBox>
                                        <TextBlock Margin="28,2,0,0" x:Name="AccentSourceDescription" Style="{StaticResource CardDescription}"
                                                   Text="Settings, Add to dictionary and the tray menu use your Windows accent color instead of Scribe blue. The recording indicator and the tray icon always use Scribe blue."/>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Button x:Name="RestoreAdvancedDefaultsButton" Content="Restore advanced defaults"
                                           HorizontalAlignment="Left" Margin="0,10,0,8"
                                           Click="RestoreAdvancedDefaultsButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================ AI cleanup ============================ -->
                    <Grid x:Name="SectionAi" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,16" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock Text="AI cleanup" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Polish punctuation, grammar and structure with a language model before the text is inserted. Optional: dictation always works without it."/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,0,14,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1000"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="AiCleanupCheck" Style="{StaticResource SettingCheckBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=AiCleanupTitle}"
                                                  AutomationProperties.HelpText="{Binding Text, ElementName=AiCleanupDescription}"
                                                  Checked="AiCleanupCheck_Toggled"
                                                  Unchecked="AiCleanupCheck_Toggled">
                                                <TextBlock x:Name="AiCleanupTitle" Text="Polish text with AI" Style="{StaticResource CardTitle}"/>
                                        </CheckBox>
                                        <TextBlock Margin="28,2,0,0" x:Name="AiCleanupDescription" Style="{StaticResource CardDescription}" Text="Fix punctuation, capitalization and grammar with an AI model before text is inserted. If the model isn't ready, dictation continues with the raw text."/>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="What leaves this PC" Style="{StaticResource CardTitle}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <!-- The wording lives in Core (CleanupDisclosure), next to the limits it quotes, so a test holds it to the code. -->
                                        <TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0"
                                                   Text="{x:Static cleanup:CleanupDisclosure.WhatCleanupSends}"/>
                                        <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                   Text="{x:Static cleanup:CleanupDisclosure.WhatCleanupNeverSends}"/>
                                        <TextBlock Style="{StaticResource CardDescription}" Margin="0,8,0,0">
                                            <Hyperlink NavigateUri="https://github.com/ChrisMcKee1/scribe/blob/main/PRIVACY.md"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                Read the Scribe AI Privacy Policy
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="AiProviderTitle" Text="Provider" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Run a model on this PC with Foundry Local (fully offline), use a Microsoft Foundry deployment via your Azure sign-in, point at any OpenAI-compatible server you already run, or use your own GitHub Copilot subscription through the Copilot CLI."/>
                                        <ComboBox x:Name="AiProviderCombo" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=AiProviderTitle}"
                                                  SelectionChanged="AiProviderCombo_SelectionChanged"/>

                                        <!-- Foundry Local (on-device) -->
                                        <StackPanel x:Name="FoundryPanel">
                                            <TextBlock x:Name="AiModelTitle" Text="Model" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                            <ComboBox x:Name="AiModelBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=AiModelTitle}"
                                                      IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                                      SelectionChanged="AiModelBox_SelectionChanged"
                                                      DropDownOpened="ModelCombo_DropDownOpened"/>
                                            <TextBlock x:Name="AiModelHint" Style="{StaticResource CardDescription}" Margin="0,6,0,0"/>
                                            <!-- Benchmark guidance so users don't pick blind (see docs/model-leaderboard.md). -->
                                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="Recommended: mistral-nemo-12b-instruct (best on-device balance) or phi-4 (best quality). See the model leaderboard in the repo docs for the full comparison."/>

                                            <!-- Load / unload: only one on-device model stays resident at a time -->
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AiLoadedModelText" Grid.Column="0" VerticalAlignment="Center"
                                                           Style="{StaticResource CardDescription}" Margin="0,0,12,0"
                                                           Text="No on-device model is loaded yet."/>
                                                <ui:Button x:Name="AiLoadButton" Grid.Column="1" Content="Load" MinWidth="80"
                                                           ToolTip="Downloads the selected model if needed (the first time, also the hardware runtime for this PC), then loads it. Only one model stays loaded."
                                                           Margin="0,0,8,0" Appearance="Primary" Click="AiLoadButton_Click"/>
                                                <ui:Button x:Name="AiUnloadButton" Grid.Column="2" Content="Unload" MinWidth="80"
                                                           Appearance="Secondary" Click="AiUnloadButton_Click"/>
                                            </Grid>

                                            <Border Style="{StaticResource CalloutBorder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Requires Foundry Local" Style="{StaticResource CardTitle}" />
                                                        <TextBlock x:Name="AiStatusText" Style="{StaticResource CardDescription}" Margin="0,2,0,0"
                                                                   Text="Nothing downloads while you browse. Load, or saving with AI cleanup on, downloads the selected model. Switching to another provider, or restarting with another one saved, removes what Foundry Local downloaded."/>
                                                        <!-- Never written by code: live status goes to AiStatusText above, so no provider's status can replace this warning. -->
                                                        <TextBlock x:Name="AiSetupNoteText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"
                                                                   Text="The first setup downloads the hardware runtime for this PC, which can be several GB. If no model is loaded afterwards, Scribe removes it again at the next start."/>
                                                    </StackPanel>
                                                    <ui:Button x:Name="AiSetupButton" Grid.Column="1" Content="Set up Foundry Local"
                                                               MinWidth="76" VerticalAlignment="Center"
                                                               ToolTip="Starts Foundry Local and fills the model dropdown above. The first setup downloads the hardware runtime for this PC, which can be several GB."
                                                               Click="AiSetupButton_Click"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Microsoft Foundry: verify sign-in before revealing cloud resources. -->
                                        <StackPanel x:Name="AzurePanel" Visibility="Collapsed">
                                            <TextBlock Text="Sign-in method" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                            <ComboBox x:Name="AzureAuthModeBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Azure sign-in method"
                                                      SelectionChanged="AzureAuthModeBox_SelectionChanged">
                                                <ComboBoxItem Content="Azure CLI (your az login account)"/>
                                                <ComboBoxItem Content="Service principal (app registration)"/>
                                                <ComboBoxItem Content="API key (personal or resource key)"/>
                                            </ComboBox>
                                            <TextBlock x:Name="AzureAuthModeHint" Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                       Text="Azure CLI uses whichever account you signed in with. Choose a service principal to pin one identity, which is the reliable option when you belong to more than one tenant."/>

                                            <!-- The Azure CLI identity, beside where a service principal's fields go. The tenant is an input
                                                 to signing in ("Sign in and find models" passes it to az login when no subscription is
                                                 selected), so it shows whether or not anyone is signed in: AzureSettingsAccess decides
                                                 when (State.ShowCliTenant). It shares one tenant setting with SpTenantBox. -->
                                            <StackPanel x:Name="AzureCliTenantPanel" Visibility="Collapsed">
                                                <TextBlock x:Name="AzureTenantLabel" Text="Tenant ID (optional)" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                                <ui:TextBox x:Name="AzureTenantBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                            VerticalContentAlignment="Center"
                                                            PlaceholderText="Entra tenant GUID"
                                                            AutomationProperties.LabeledBy="{Binding ElementName=AzureTenantLabel}"
                                                            TextChanged="AzureTenantBox_TextChanged"/>
                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                           Text="Leave blank to use the tenant Azure CLI is currently using. If your account belongs to more than one tenant, enter the one that holds your model. Signing in and cleanup use it whenever no subscription is selected."/>
                                            </StackPanel>

                                            <StackPanel x:Name="AzureServicePrincipalPanel" Visibility="Collapsed">
                                                <TextBlock x:Name="SpTenantTitle" Text="Directory (tenant) ID" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                                <ui:TextBox x:Name="SpTenantBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                            VerticalContentAlignment="Center"
                                                            PlaceholderText="GUID, or contoso.onmicrosoft.com"
                                                            AutomationProperties.LabeledBy="{Binding ElementName=SpTenantTitle}"
                                                            TextChanged="ServicePrincipalField_Changed"/>

                                                <TextBlock x:Name="SpClientIdTitle" Text="Application (client) ID" Style="{StaticResource CardTitle}" Margin="0,14,0,0"/>
                                                <ui:TextBox x:Name="SpClientIdBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                            VerticalContentAlignment="Center"
                                                            PlaceholderText="GUID from the app registration overview"
                                                            AutomationProperties.LabeledBy="{Binding ElementName=SpClientIdTitle}"
                                                            TextChanged="ServicePrincipalField_Changed"/>

                                                <TextBlock x:Name="SpClientSecretTitle" Text="Client secret" Style="{StaticResource CardTitle}" Margin="0,14,0,0"/>
                                                <ui:PasswordBox x:Name="SpClientSecretBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                                VerticalContentAlignment="Center"
                                                                PlaceholderText="The secret Value, not the Secret ID"
                                                                AutomationProperties.LabeledBy="{Binding ElementName=SpClientSecretTitle}"
                                                                PasswordChanged="ServicePrincipalField_Changed"/>
                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                           Text="The secret is encrypted on this PC with Windows DPAPI and is never written to an environment variable or a file. Azure shows the secret Value only once, when you create it."/>
                                                <TextBlock x:Name="SpValidationText" Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                           Visibility="Collapsed"/>
                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,8,0,0">
                                                    <Hyperlink NavigateUri="https://github.com/ChrisMcKee1/scribe/blob/main/docs/service-principal-setup.md"
                                                               RequestNavigate="Hyperlink_RequestNavigate">
                                                        How to create a service principal and grant it access to your model
                                                    </Hyperlink>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Style="{StaticResource CalloutBorder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock x:Name="AzureStatusTitle" Text="Use your Azure sign-in" Style="{StaticResource CardTitle}" />
                                                        <TextBlock x:Name="AzureStatusText" Style="{StaticResource CardDescription}" Margin="0,2,0,0"
                                                                   Text="Checking your Azure CLI sign-in before showing cloud resources."/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button x:Name="AzureManualButton" Content="Use endpoint instead"
                                                                   MinWidth="118" Margin="0,0,8,0" Appearance="Secondary"
                                                                   Click="AzureManualButton_Click"/>
                                                        <ui:Button x:Name="AzureRefreshButton" Content="Sign in and find models"
                                                                   MinWidth="124" Appearance="Primary" IsEnabled="False"
                                                                   Click="AzureRefreshButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="AzureCliSetupPanel" Style="{StaticResource CalloutBorder}" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Azure CLI required" Style="{StaticResource CardTitle}" />
                                                        <TextBlock x:Name="AzureCliStatusText" Style="{StaticResource CardDescription}" Margin="0,2,0,0"
                                                                   Text="Install Azure CLI to use browser sign-in and discover models. Manual API-key setup remains available."/>
                                                    </StackPanel>
                                                    <ui:Button x:Name="AzureCliButton" Grid.Column="1" Content="Install Azure CLI"
                                                               MinWidth="76" VerticalAlignment="Center"
                                                               Click="AzureCliButton_Click"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel x:Name="AzureDiscoveryPanel" Visibility="Collapsed">
                                                <TextBlock Text="Subscription" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                                <ComboBox x:Name="AzureSubscriptionBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="Azure subscription"
                                                          SelectionChanged="AzureSubscriptionBox_SelectionChanged"/>
                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                           Text="Scribe starts with the active Azure CLI subscription. Choose All subscriptions only when you need to browse every subscription this verified sign-in can access."/>

                                                <TextBlock Text="Model" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                                <ComboBox x:Name="AzureModelBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="Azure model deployment"
                                                          IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                                          SelectionChanged="AzureModelBox_SelectionChanged"
                                                          DropDownOpened="ModelCombo_DropDownOpened"
                                                          LostFocus="AzureModelBox_LostFocus"/>
                                                <TextBlock x:Name="AzureDeploymentHint" Style="{StaticResource CardDescription}" Margin="0,6,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="AzureConfigurationPanel" Visibility="Collapsed">
                                                <TextBlock Text="Cleanup status" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                                <TextBlock x:Name="AzureCleanupStatusText" Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                           Text="Cleanup readiness appears here after the configuration is validated."/>

                                                <TextBlock x:Name="AzureEndpointTitle" Text="Endpoint" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                                <ui:TextBox x:Name="AzureEndpointBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                            VerticalContentAlignment="Center"
                                                            PlaceholderText="https://my-resource.services.ai.azure.com/"
                                                            AutomationProperties.LabeledBy="{Binding ElementName=AzureEndpointTitle}"
                                                            TextChanged="AzureEndpointBox_TextChanged"/>
                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                           Text="A discovered model fills this automatically. For manual setup, paste the Microsoft Foundry project or Azure OpenAI endpoint."/>

                                                <TextBlock x:Name="AzureDeploymentTitle" Text="Deployment name" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                                <ui:TextBox x:Name="AzureDeploymentBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                            VerticalContentAlignment="Center"
                                                            PlaceholderText="e.g. gpt-4o"
                                                            AutomationProperties.LabeledBy="{Binding ElementName=AzureDeploymentTitle}"
                                                            TextChanged="AzureDeploymentBox_TextChanged"/>
                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                           Text="The model picker fills this in after sign-in. Enter the exact Azure deployment name when configuring manually."/>

                                                <StackPanel x:Name="AzureApiKeyPanel" Visibility="Collapsed">
                                                    <TextBlock x:Name="AzureApiKeyTitle" Text="API key" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                                    <ui:PasswordBox x:Name="AzureApiKeyBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                                    VerticalContentAlignment="Center"
                                                                    PlaceholderText="Paste your Azure OpenAI or Foundry resource key"
                                                                    AutomationProperties.LabeledBy="{Binding ElementName=AzureApiKeyTitle}"
                                                                    PasswordChanged="AzureApiKeyBox_PasswordChanged"/>
                                                    <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                               Text="An API key needs no app registration or tenant permissions. It is stored encrypted on this PC with Windows DPAPI."/>
                                                    <TextBlock x:Name="AzureProjectApiKeyHint" Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               Visibility="Collapsed"
                                                               Text="Project endpoints use the account host with API keys. This is expected because project data planes require Entra sign-in."/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Bring-your-own OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter...) -->
                                        <StackPanel x:Name="CustomPanel" Visibility="Collapsed">
                                            <TextBlock x:Name="CustomEndpointTitle" Text="Endpoint URL" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                            <ui:TextBox x:Name="CustomEndpointBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                        VerticalContentAlignment="Center"
                                                        PlaceholderText="http://localhost:11434/v1"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CustomEndpointTitle}"/>
                                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                       Text="Any server that speaks the OpenAI chat protocol: Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1), vLLM, OpenRouter (https://openrouter.ai/api/v1), or api.openai.com/v1. Usually ends in /v1."/>

                                            <TextBlock x:Name="CustomModelTitle" Text="Model" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                            <ui:TextBox x:Name="CustomModelBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                        VerticalContentAlignment="Center"
                                                        PlaceholderText="e.g. qwen3:4b, llama3.1:8b, gpt-4o-mini"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=CustomModelTitle}"/>
                                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                       Text="The model name exactly as the server knows it (for Ollama, what 'ollama list' shows)."/>

                                            <TextBlock x:Name="CustomApiKeyTitle" Text="API key (optional)" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                            <ui:PasswordBox x:Name="CustomApiKeyBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                            VerticalContentAlignment="Center"
                                                            PlaceholderText="Leave blank for local servers like Ollama or LM Studio"
                                                            AutomationProperties.LabeledBy="{Binding ElementName=CustomApiKeyTitle}"/>
                                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                       Text="Only needed for hosted services (OpenRouter, OpenAI). Stored encrypted on this PC (Windows DPAPI). Requests carry text, never audio: your audio never leaves this device."/>
                                        </StackPanel>

                                        <StackPanel x:Name="CopilotPanel" Visibility="Collapsed">
                                            <!-- The CLI this provider runs on. Shown first because
                                                 nothing below it works without it, and because it is
                                                 the one dependency Scribe cannot install silently. -->
                                            <ui:InfoBar x:Name="CopilotCliBar" Margin="0,12,0,0"
                                                        IsOpen="True" IsClosable="False"
                                                        Title="Checking for the GitHub Copilot CLI…"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <ui:Button x:Name="CopilotInstallButton" Content="Install the CLI"
                                                           MinWidth="150" Click="CopilotInstallButton_Click"/>
                                                <ui:Button x:Name="CopilotRecheckButton" Content="Check again"
                                                           Margin="8,0,0,0" MinWidth="120"
                                                           Click="CopilotRecheckButton_Click"/>
                                                <ui:Button x:Name="CopilotSignInButton" Content="Sign in"
                                                           Margin="8,0,0,0" MinWidth="110"
                                                           Click="CopilotSignInButton_Click"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,8,0,0"
                                                       Text="Uses your own GitHub Copilot subscription and the models it includes. Scribe never asks for or stores a GitHub token."/>

                                            <TextBlock x:Name="CopilotModelTitle" Text="Model" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CopilotModelCombo" Grid.Column="0"
                                                          IsEditable="True" HorizontalAlignment="Stretch"
                                                          VerticalContentAlignment="Center"
                                                          AutomationProperties.LabeledBy="{Binding ElementName=CopilotModelTitle}"/>
                                                <ui:Button x:Name="CopilotLoadModelsButton" Grid.Column="1"
                                                           Content="Refresh models" Margin="8,0,0,0" MinWidth="140"
                                                           Click="CopilotLoadModelsButton_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="CopilotModelHint" Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                       Text="Leave blank to use whichever model your Copilot account defaults to. The list is read from your Copilot subscription when you select this provider; Refresh models re-reads it after an install or a sign-in."/>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="AiWritingStyleTitle" Text="Writing style" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource CardDescription}" Margin="0,2,0,0"
                                                   Text="This guidance is sent to the AI model every time it polishes your dictation. Describe the tone, punctuation and structure you want, or leave the default."/>
                                        <ui:TextBox x:Name="AiWritingStyleBox" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="260"
                                                    VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                    TextAlignment="Left" SpellCheck.IsEnabled="False"
                                                    AutomationProperties.LabeledBy="{Binding ElementName=AiWritingStyleTitle}"/>
                                        <ui:Button x:Name="ResetWritingStyleButton" Content="Restore default" Margin="0,10,0,0"
                                                   HorizontalAlignment="Left" Appearance="Secondary"
                                                   Click="ResetWritingStyleButton_Click"/>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="AiPromptStyleTitle" Text="Cleanup prompt" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource CardDescription}" Margin="0,2,0,0"
                                                   Text="Which system prompt drives cleanup. Automatic uses a prompt tuned for small on-device models when you run Foundry Local, and the frontier prompt for cloud models. You can force either, or edit them below."/>
                                        <ComboBox x:Name="AiPromptStyleCombo" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=AiPromptStyleTitle}"
                                                  SelectionChanged="AiPromptStyleCombo_SelectionChanged"/>

                                        <ui:CardExpander x:Name="PromptEditExpander" Margin="0,14,0,0" IsExpanded="False"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=PromptEditTitle}">
                                            <ui:CardExpander.Header>
                                                <StackPanel>
                                                    <TextBlock x:Name="PromptEditTitle" Text="Edit the prompts (advanced)" Style="{StaticResource CardTitle}" />
                                                    <TextBlock Style="{StaticResource CardDescription}" Margin="0,2,0,0"
                                                               Text="Fine-tune the instructions sent to the model. Leave a box on its default to keep tracking future improvements. Each prompt restores on its own."/>
                                                </StackPanel>
                                            </ui:CardExpander.Header>
                                            <StackPanel Margin="0,4,0,0">
                                                <TextBlock x:Name="AiFrontierPromptTitle" Text="Frontier prompt (cloud and capable models)" Style="{StaticResource CardTitle}"/>
                                                <ui:TextBox x:Name="AiFrontierPromptBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="220"
                                                            VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                            TextAlignment="Left" SpellCheck.IsEnabled="False"
                                                            AutomationProperties.LabeledBy="{Binding ElementName=AiFrontierPromptTitle}"/>
                                                <ui:Button x:Name="ResetFrontierPromptButton" Content="Restore default frontier prompt" Margin="0,8,0,0"
                                                           HorizontalAlignment="Left" Appearance="Secondary"
                                                           Click="ResetFrontierPromptButton_Click"/>

                                                <TextBlock x:Name="AiLocalPromptTitle" Text="Local prompt (on-device and small models)" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                                <ui:TextBox x:Name="AiLocalPromptBox" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="220"
                                                            VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                            TextAlignment="Left" SpellCheck.IsEnabled="False"
                                                            AutomationProperties.LabeledBy="{Binding ElementName=AiLocalPromptTitle}"/>
                                                <ui:Button x:Name="ResetLocalPromptButton" Content="Restore default local prompt" Margin="0,8,0,0"
                                                           HorizontalAlignment="Left" Appearance="Secondary"
                                                           Click="ResetLocalPromptButton_Click"/>
                                            </StackPanel>
                                        </ui:CardExpander>
                                    </StackPanel>
                                </ui:Card>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================ Dictionary ============================ -->
                    <Grid x:Name="SectionDictionary" Visibility="Collapsed">
                        <!-- List page shell (6.5.6): the tabs fill the star row, so each tab's grid owns its scrolling. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,14" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock x:Name="DictionaryPageTitle" Text="Dictionary" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Replace spoken words or phrases with the spelling you actually want. 'azure' becomes 'Azure', 'dot net' becomes '.NET'. Whole word matches on word boundaries only; clear it for phrase replacement. Edits apply when you save."/>
                        </StackPanel>
                        <TabControl x:Name="DictionaryTabs" Grid.Row="1">
                            <TabItem x:Name="YourWordsTab" Header="Your words">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button x:Name="DictionaryAddButton" Content="Add word"
                                       Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                       Margin="0,0,8,0" Click="DictionaryAddButton_Click"
                                       ToolTip="Add a blank entry and start editing it."/>
                            <ui:Button x:Name="DictionarySuggestButton" Content="Learn from history"
                                       Icon="{ui:SymbolIcon Lightbulb24}"
                                       Margin="0,0,8,0" Click="DictionarySuggestButton_Click"
                                       ToolTip="Learn vocabulary from recent dictations. A configured remote AI provider receives a bounded text sample only after you confirm; otherwise Scribe scans locally."/>
                            <ui:Button x:Name="DictionaryCleanupButton" Content="Clean up unused words..."
                                       Icon="{ui:SymbolIcon Broom24}"
                                       Margin="0,0,8,0" Click="DictionaryCleanupButton_Click"
                                       ToolTip="Scan your dictation history for entries and libraries whose wording has not come up in anything you have dictated, so they stop crowding out the vocabulary you do use. Nothing is removed without your review."/>
                            <ui:Button x:Name="DictionaryImportButton" Content="Import CSV"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Margin="0,0,8,0" Click="DictionaryImportButton_Click"
                                       ToolTip="Merge entries from a CSV file into this dictionary."/>
                            <ui:Button x:Name="DictionaryExportButton" Content="Export CSV"
                                       Icon="{ui:SymbolIcon ArrowUpload24}"
                                       Margin="0,0,8,0" Click="DictionaryExportButton_Click"
                                       ToolTip="Save this dictionary as a CSV file to back up or share."/>
                            <ui:Button x:Name="DictionaryTemplateButton" Content="Get template"
                                       Icon="{ui:SymbolIcon DocumentAdd24}"
                                       Click="DictionaryTemplateButton_Click"
                                       ToolTip="Save a starter CSV you can fill in with a spreadsheet and share."/>
                            <StackPanel x:Name="DictionarySuggestBusy" Orientation="Horizontal"
                                        Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <ProgressBar Width="72" Height="4" IsIndeterminate="True"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="Learning from history…"
                                           Style="{StaticResource CardDescription}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="DictionaryCleanupBusy" Orientation="Horizontal"
                                        Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <ProgressBar Width="72" Height="4" IsIndeterminate="True"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="Checking your history…"
                                           Style="{StaticResource CardDescription}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                        <ui:Card Grid.Row="1" Padding="0" Style="{StaticResource PanelCard}">
                            <DataGrid x:Name="DictionaryGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Background="Transparent" BorderThickness="0"
                                      AutomationProperties.LabeledBy="{Binding ElementName=DictionaryPageTitle}">
                                <DataGrid.Columns>
                                    <!-- While a cell edits, its text box would otherwise be named by the text it holds
                                         (TextBox.GetPlainText); the columns name it after their header instead. The
                                         style keeps WPF's own editing style, the column's default. -->
                                    <DataGridTextColumn Header="Spoken" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
                                                <Setter Property="AutomationProperties.Name" Value="Spoken"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Replacement" Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
                                                <Setter Property="AutomationProperties.Name" Value="Replacement"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Live comparison against the libraries that are switched on, so a user can
                                         see at a glance which entries are doing real work and which are clutter. -->
                                    <DataGridTemplateColumn Header="Word pack" Width="150" CanUserSort="True"
                                                            SortMemberPath="Coverage">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Badge Appearance="{Binding CoverageAppearance}"
                                                          Margin="4,2" VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Visibility="{Binding CoverageVisibility}"
                                                          ToolTip="{Binding CoverageTooltip}">
                                                    <TextBlock Text="{Binding CoverageLabel}" FontSize="12"/>
                                                </ui:Badge>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="Whole word" Binding="{Binding WholeWord, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                            ElementStyle="{StaticResource WholeWordCheckBox}"
                                                            EditingElementStyle="{StaticResource WholeWordCheckBoxEditing}"/>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                            ElementStyle="{StaticResource EntryEnabledCheckBox}"
                                                            EditingElementStyle="{StaticResource EntryEnabledCheckBoxEditing}"/>
                                    <DataGridTemplateColumn Header="" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                                           Padding="6,2" Margin="0" ToolTip="Remove this entry"
                                                           Style="{StaticResource DictionaryRemoveButton}"
                                                           Click="DictionaryDeleteRow_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ui:Card>
                        <StackPanel Grid.Row="2" Margin="2,8,2,0">
                            <TextBlock x:Name="DictionaryGlossaryHint" Style="{StaticResource CardDescription}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                                </Grid>
                            </TabItem>
                            <TabItem Header="Word packs">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button x:Name="LibraryImportButton" Content="Import a word pack..."
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Margin="0,0,8,0" Click="LibraryImportButton_Click"
                                       ToolTip="Add a dictionary word pack from a CSV file."/>
                            <ui:Button x:Name="LibraryExportButton" Content="Export CSV"
                                       Icon="{ui:SymbolIcon ArrowUpload24}"
                                       Margin="0,0,8,0" Click="LibraryExportButton_Click"
                                       ToolTip="Save the selected word pack as a CSV file to back up or share."/>
                            <ui:Button x:Name="LibraryRemoveButton" Content="Remove"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Click="LibraryRemoveButton_Click"
                                       ToolTip="Remove the selected imported word pack. Built-in libraries can only be turned off."/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*" MinWidth="240"/>
                            </Grid.ColumnDefinitions>
                            <ui:Card Grid.Column="0" Padding="0" Style="{StaticResource PanelCard}">
                                <!-- One A to Z list of built-in and custom libraries, placed by the window when the page
                                     loads (LibraryOrdering). No column sorts: a header click would re-sort it, and a sorted
                                     view moves a row the moment its box is ticked. -->
                                <DataGrid x:Name="LibraryGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserSortColumns="False"
                                          SelectionMode="Single"
                                          SelectionChanged="LibraryGrid_SelectionChanged"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0"
                                          RowStyle="{StaticResource LibraryRow}"
                                          AutomationProperties.Name="Word packs">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource LibraryOnCheckBox}"
                                                                EditingElementStyle="{StaticResource LibraryOnCheckBoxEditing}"/>
                                        <!-- The 2 px side margin is the one WPF gives a text column's text, so the name lines
                                             up with the Category and Terms text beside it. The two lines carry their own
                                             leading, so a 1 px top and bottom keeps a default window showing every
                                             shipped word pack without scrolling, as the one-line rows did. A template column,
                                             unlike a text column, has no binding to fall back on for Ctrl+C or for the cell's
                                             UI Automation value, so ClipboardContentBinding supplies the name for both. The
                                             name line, and only it, takes LibraryNameText's SemiBold cue for the selected row. -->
                                        <DataGridTemplateColumn Header="Word pack" Width="*" IsReadOnly="True"
                                                                ClipboardContentBinding="{Binding Name}"
                                                                CellStyle="{StaticResource LibraryNameCell}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource LibraryNameText}"/>
                                                        <TextBlock Text="{Binding Source}" FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Terms" Binding="{Binding Terms}" Width="Auto" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ui:Card>
                            <ui:Card Grid.Column="2" Padding="14" Style="{StaticResource EditorPanelCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock x:Name="LibraryDetailName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="LibraryDetailMeta" Style="{StaticResource CardDescription}" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="LibraryDetailDesc" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <DataGrid x:Name="LibraryTermsGrid" Grid.Row="1"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              Background="Transparent" BorderThickness="0"
                                              AutomationProperties.LabeledBy="{Binding ElementName=LibraryDetailName}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Spoken" Binding="{Binding Pattern}" Width="*"/>
                                            <DataGridTextColumn Header="Written" Binding="{Binding Replacement}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="LibraryDetailEmpty" Grid.Row="1"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                               Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                               Text="Select a word pack to see its words."/>
                                </Grid>
                            </ui:Card>
                        </Grid>

                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <!-- ============================ Snippets ============================ -->
                    <Grid x:Name="SectionVoiceSnippets" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,14" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock x:Name="SnippetsPageTitle" Text="Voice snippets" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Say a trigger phrase, like 'insert my standup update', and Scribe types the saved template instead. Pick distinctive phrases you wouldn't say by accident. Edits apply when you save."/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:Card Grid.Column="0" Padding="8" Margin="0,0,10,0" Style="{StaticResource PanelCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="SnippetList" Grid.Row="0" BorderThickness="0"
                                             Background="Transparent" DisplayMemberPath="Phrase"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SnippetsPageTitle}"
                                             SelectionChanged="SnippetList_SelectionChanged"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:Button x:Name="SnippetAddButton" Content="Add" MinWidth="70"
                                                   Margin="0,0,8,0" Click="SnippetAddButton_Click"/>
                                        <ui:Button x:Name="SnippetDeleteButton" Content="Delete" MinWidth="70"
                                                   Click="SnippetDeleteButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <ui:Card Grid.Column="1" Padding="18,14" Style="{StaticResource EditorPanelCard}">
                                <Grid>
                                    <StackPanel x:Name="SnippetEditor" Visibility="Collapsed" VerticalAlignment="Top">
                                        <TextBlock x:Name="SnippetPhraseTitle" Text="Trigger phrase" Style="{StaticResource CardTitle}"/>
                                        <ui:TextBox x:Name="SnippetPhraseBox" Margin="0,8,0,0"
                                                    HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                                    PlaceholderText="insert my standup update"
                                                    AutomationProperties.LabeledBy="{Binding ElementName=SnippetPhraseTitle}"
                                                    TextChanged="SnippetPhraseBox_TextChanged"/>
                                        <StackPanel Margin="0,16,0,0">
                                            <CheckBox x:Name="SnippetEnabledCheck" Style="{StaticResource SettingCheckBox}"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=SnippetEnabledLabel}"
                                                      AutomationProperties.HelpText="{Binding Text, ElementName=SnippetEnabledDescription}"
                                                      Click="SnippetEnabledCheck_Click">
                                                <TextBlock x:Name="SnippetEnabledLabel" Text="Enabled" Style="{StaticResource CardTitle}"/>
                                            </CheckBox>
                                            <TextBlock x:Name="SnippetEnabledDescription" Style="{StaticResource CardDescription}" Margin="28,2,0,0"
                                                       Text="Applies this voice snippet after you save."/>
                                        </StackPanel>
                                        <TextBlock x:Name="SnippetTemplateTitle" Text="Expands to" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                        <ui:TextBox x:Name="SnippetTemplateBox" Margin="0,8,0,0"
                                                    HorizontalAlignment="Stretch" AcceptsReturn="True"
                                                    TextWrapping="Wrap" MinHeight="220" MaxHeight="380"
                                                    VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                    SpellCheck.IsEnabled="True"
                                                    AutomationProperties.LabeledBy="{Binding ElementName=SnippetTemplateTitle}"
                                                    TextChanged="SnippetTemplateBox_TextChanged"/>
                                        <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                   Text="Line breaks are kept, except in terminals when 'Smart' line-break handling is on, where they become spaces so Enter isn't sent."/>
                                    </StackPanel>
                                    <TextBlock x:Name="SnippetEmptyHint"
                                               Text="Select a snippet on the left, or click Add to create one."
                                               Style="{StaticResource CardDescription}" Margin="0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Card>
                        </Grid>
                    </Grid>

                    <!-- ============================ Profiles ============================ -->
                    <Grid x:Name="SectionAppProfiles" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,14" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock x:Name="ProfilesPageTitle" Text="App profiles" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Use a different writing style or line-break rule in specific apps, like Outlook or Teams."/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:Card Grid.Column="0" Padding="8" Margin="0,0,10,0" Style="{StaticResource PanelCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="ProfileList" Grid.Row="0" BorderThickness="0"
                                             Background="Transparent" DisplayMemberPath="Name"
                                             AutomationProperties.LabeledBy="{Binding ElementName=ProfilesPageTitle}"
                                             SelectionChanged="ProfileList_SelectionChanged"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:Button x:Name="ProfileAddButton" Content="Add" MinWidth="70"
                                                   Margin="0,0,8,0" Click="ProfileAddButton_Click"/>
                                        <ui:Button x:Name="ProfileDeleteButton" Content="Delete" MinWidth="70"
                                                   Click="ProfileDeleteButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <ui:Card Grid.Column="1" Padding="18,14" Style="{StaticResource EditorPanelCard}">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ProfileEditor" Visibility="Collapsed" VerticalAlignment="Top">
                                            <TextBlock x:Name="ProfileNameTitle" Text="Profile name" Style="{StaticResource CardTitle}"/>
                                            <ui:TextBox x:Name="ProfileNameBox" Margin="0,8,0,0"
                                                        HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                                        PlaceholderText="e.g. Email"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=ProfileNameTitle}"
                                                        TextChanged="ProfileNameBox_TextChanged"/>

                                            <TextBlock x:Name="ProfileProcessesTitle" Text="Apps (process names)" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                            <ui:TextBox x:Name="ProfileProcessesBox" Margin="0,8,0,0"
                                                        HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                                        PlaceholderText="OUTLOOK, olk, thunderbird"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=ProfileProcessesTitle}"
                                                        TextChanged="ProfileProcessesBox_TextChanged"/>
                                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                       Text="Comma-separated process names, without .exe (Task Manager's Details tab shows them). Examples: OUTLOOK for classic Outlook, olk for new Outlook, slack, WindowsTerminal, Code for VS Code."/>

                                            <TextBlock x:Name="ProfileStyleTitle" Text="Writing style for these apps" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                            <ui:TextBox x:Name="ProfileStyleBox" Margin="0,8,0,0"
                                                        HorizontalAlignment="Stretch" AcceptsReturn="True"
                                                        TextWrapping="Wrap" MinHeight="120" MaxHeight="220"
                                                        VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                        SpellCheck.IsEnabled="True"
                                                        AutomationProperties.LabeledBy="{Binding ElementName=ProfileStyleTitle}"
                                                        TextChanged="ProfileStyleBox_TextChanged"/>
                                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                                       Text="Leave blank to keep your global writing style. Needs AI cleanup to be enabled to take effect."/>

                                            <TextBlock x:Name="ProfileNewlineTitle" Text="Line breaks in these apps" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                            <ComboBox x:Name="ProfileNewlineCombo" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=ProfileNewlineTitle}"
                                                      SelectionChanged="ProfileNewlineCombo_SelectionChanged"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <TextBlock x:Name="ProfileEmptyHint"
                                               Text="Select a profile on the left, or click Add to create one."
                                               Style="{StaticResource CardDescription}" Margin="0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Card>
                        </Grid>
                    </Grid>

                    <!-- ============================ Try dictation ============================ -->
                    <Grid x:Name="SectionTryDictation" Visibility="Collapsed"
                          Loaded="TryDictationSection_Loaded"
                          IsVisibleChanged="TryDictationSection_IsVisibleChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,14" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock Text="Try dictation" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Check that dictation works, and see what Scribe changed."/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,0,14,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1000"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid x:Name="TryDictationUnsavedHost" Margin="0,0,0,12" Visibility="Collapsed">
                                        <ui:InfoBar x:Name="TryDictationUnsavedBar"
                                                    Severity="Informational" IsOpen="False" IsClosable="False"
                                                    Message="You have unsaved changes. Try dictation uses the settings Scribe is running with."
                                                    AutomationProperties.LiveSetting="Polite"/>
                                        <ui:Button x:Name="TryDictationSaveNowButton" Content="Save now" MinWidth="96"
                                                   Margin="0,8,12,8" HorizontalAlignment="Right"
                                                   Click="TryDictationSaveNow_Click"/>
                                    </Grid>

                                    <ui:InfoBar x:Name="TryDictationRestartBar" Margin="0,0,0,12"
                                                Severity="Informational" IsOpen="False" IsClosable="False"
                                                Message="Restart Scribe before Try dictation uses these changes."
                                                AutomationProperties.LiveSetting="Polite"/>

                                    <TextBlock Text="Try it" Style="{StaticResource SectionHeader}" Margin="1,4,0,8"/>
                                    <ui:Card Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="TryDictationPrimaryInstruction" Style="{StaticResource CardTitle}"/>
                                            <TextBlock x:Name="TryDictationSecondaryInstruction" Style="{StaticResource CardDescription}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                            <TextBlock x:Name="TryDictationSampleText" Style="{StaticResource CardDescription}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="TryDictationSecondSampleText" Style="{StaticResource CardDescription}" Margin="0,2,0,0" Visibility="Collapsed"/>
                                            <ui:TextBox x:Name="PlaygroundInput" Margin="0,10,0,0"
                                                        HorizontalAlignment="Stretch" AcceptsReturn="True"
                                                        TextWrapping="Wrap" MinHeight="150" MaxHeight="280"
                                                        VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                        SpellCheck.IsEnabled="True"
                                                        AutomationProperties.Name="Try dictation box"
                                                        AutomationProperties.HelpText="{Binding Text, ElementName=TryDictationPrimaryInstruction}"/>
                                            <ui:Button Content="Clear" HorizontalAlignment="Right" MinWidth="84" Margin="0,8,0,0"
                                                       Click="TryDictationClear_Click"/>
                                        </StackPanel>
                                    </ui:Card>

                                    <TextBlock Text="Result" Style="{StaticResource SectionHeader}"/>
                                    <ui:Card Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="TryDictationEmptyText"
                                                       Style="{StaticResource CardDescription}"
                                                       Text="Your result appears here after you dictate into the box."/>
                                            <StackPanel x:Name="TryDictationResultPanel" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon x:Name="TryDictationSummaryIcon" Grid.Column="0" Symbol="CheckmarkCircle24" FontSize="16" Margin="0,2,8,0"
                                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                    <TextBlock x:Name="TryDictationSummaryText" Grid.Column="1"
                                                               Style="{StaticResource TryDictationResultText}"
                                                               Margin="0" AutomationProperties.LiveSetting="Polite"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                                        <ui:Button x:Name="TryDictationSoundSettingsButton" Content="Open sound settings"
                                                                   MinWidth="140" Visibility="Collapsed" Click="SoundSettings_Click"/>
                                                        <ui:Button x:Name="TryDictationAiCleanupButton" Content="Open AI cleanup"
                                                                   MinWidth="130" Visibility="Collapsed" Click="TryDictationOpenAiCleanup_Click"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="TryDictationHeardSection">
                                                    <TextBlock Text="What Scribe heard" Style="{StaticResource TryDictationResultLabel}" Margin="0,16,0,0"/>
                                                    <TextBlock x:Name="TryDictationHeardText" Style="{StaticResource TryDictationResultText}"/>
                                                </StackPanel>

                                                <StackPanel x:Name="TryDictationTypedSection">
                                                    <TextBlock Text="What Scribe typed" Style="{StaticResource TryDictationResultLabel}"/>
                                                    <TextBlock x:Name="TryDictationTypedText" Style="{StaticResource TryDictationResultText}"/>
                                                </StackPanel>

                                                <StackPanel x:Name="TryDictationChangesSection">
                                                    <TextBlock x:Name="TryDictationChangesTitle" Style="{StaticResource TryDictationResultLabel}"/>
                                                    <ItemsControl x:Name="TryDictationChangesList" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Style="{StaticResource TryDictationResultText}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <ui:CardExpander x:Name="TryDictationTimingExpander" Margin="0,16,0,0"
                                                                 IsExpanded="False" AutomationProperties.Name="Timing details">
                                                    <ui:CardExpander.Header>
                                                        <TextBlock Text="Timing details" Style="{StaticResource CardTitle}"/>
                                                    </ui:CardExpander.Header>
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Text="Recording" Style="{StaticResource CardDescription}"/>
                                                        <TextBlock x:Name="PlaygroundCaptureDuration" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="PlaygroundCaptureDetail" Grid.Row="0" Grid.Column="2" Style="{StaticResource CardDescription}"/>

                                                        <TextBlock Grid.Row="1" Text="Trimming silence" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundVadDuration" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundVadDetail" Grid.Row="1" Grid.Column="2" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>

                                                        <TextBlock Grid.Row="2" Text="Speech recognition" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundDecodeDuration" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundDecodeDetail" Grid.Row="2" Grid.Column="2" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>

                                                        <TextBlock Grid.Row="3" Text="AI cleanup" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundAiDuration" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundAiDetail" Grid.Row="3" Grid.Column="2" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>

                                                        <TextBlock Grid.Row="4" Text="Dictionary and snippets" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundPostDuration" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundPostDetail" Grid.Row="4" Grid.Column="2" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>

                                                        <TextBlock Grid.Row="5" Text="Typing" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundInjectionDuration" Grid.Row="5" Grid.Column="1" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundInjectionDetail" Grid.Row="5" Grid.Column="2" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>

                                                        <TextBlock Grid.Row="6" Text="Processing, all steps" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundTotalDuration" Grid.Row="6" Grid.Column="1" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="PlaygroundTotalDetail" Grid.Row="6" Grid.Column="2" Style="{StaticResource CardDescription}" Margin="0,8,0,0"/>
                                                    </Grid>
                                                </ui:CardExpander>
                                            </StackPanel>
                                        </StackPanel>
                                    </ui:Card>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================ History ============================ -->
                    <Grid x:Name="SectionHistory" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,14" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock x:Name="HistoryPageTitle" Text="History" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Find, copy or delete your recent dictations."/>
                            <ui:Card x:Name="HistorySettingsCard" Style="{StaticResource SettingsCard}" Margin="0,12,0,4">
                                <StackPanel>
                                    <TextBlock Text="History settings" Style="{StaticResource CardTitle}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Keep dictations" Style="{StaticResource CardTitle}"/>
                                            <TextBlock x:Name="HistoryRetentionHintText" Style="{StaticResource CardDescription}" Text="Older dictations are deleted automatically."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="HistoryRetentionCombo" Width="240" DisplayMemberPath="Label"
                                                      SelectionChanged="DurationCombo_SelectionChanged"
                                                      AutomationProperties.Name="Keep dictations"/>
                                            <ui:NumberBox x:Name="HistoryRetentionCustomBox" Width="96" Margin="8,0,0,0"
                                                          SmallChange="1"
                                                          MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                                          SpinButtonPlacementMode="Inline"
                                                          Visibility="Collapsed"
                                                          AutomationProperties.Name="Keep dictations custom days"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,14,0,0">
                                        <CheckBox x:Name="StoreAudioCheck" Style="{StaticResource SettingCheckBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=StoreAudioTitle}"
                                                  AutomationProperties.HelpText="{Binding Text, ElementName=StoreAudioHintText}">
                                            <TextBlock x:Name="StoreAudioTitle" Text="Save a recording with each dictation" Style="{StaticResource CardTitle}"/>
                                        </CheckBox>
                                        <TextBlock Margin="28,2,0,0" x:Name="StoreAudioHintText" Style="{StaticResource CardDescription}" Text="Keeps the audio of each dictation on this PC for up to 7 days (250 MB in total), then deletes it. Scribe doesn't play recordings back."/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                        <ui:Card Grid.Row="1" Padding="0" Style="{StaticResource PanelCard}">
                            <Grid>
                                <DataGrid x:Name="HistoryGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                                          Background="Transparent" BorderThickness="0"
                                          AutomationProperties.LabeledBy="{Binding ElementName=HistoryPageTitle}"
                                          SelectionChanged="HistoryGrid_SelectionChanged"
                                          MouseDoubleClick="HistoryGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="Auto"/>
                                        <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding Text}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="App" Binding="{Binding App}" Width="Auto"/>
                                        <DataGridTextColumn Header="Audio" Binding="{Binding Audio}" Width="Auto"/>
                                        <DataGridTextColumn Header="Decode" Binding="{Binding Decode}" Width="Auto"/>
                                        <!-- Scoped to the RESULT, never to Scribe. Store policy requires any
                                             rating OF THE APP to route to the Store's own mechanism regardless
                                             of sentiment, and treats a private thumbs-down path paired with a
                                             public thumbs-up path as a fraudulent practice. The header says
                                             "Result" for that reason; do not retitle it to anything that reads
                                             as rating the product. -->
                                        <DataGridTemplateColumn Header="Result" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- The thumbs draw a glyph, which UI Automation would read as their
                                                         name, so each is named for what it does and whether it is the
                                                         rating given (the filled glyph); the report button after its
                                                         ToolTip. -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding ProducedByAi, Converter={StaticResource BoolToVisibility}}">
                                                        <ui:Button Style="{StaticResource HistoryThumbButton}"
                                                                Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanRate}"
                                                                ToolTip="This rewrite was useful"
                                                                AutomationProperties.Name="{Binding ThumbUpName}"
                                                                Click="HistoryThumbUp_Click">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="ThumbLike24">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Filled" Value="False"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Rating}" Value="{x:Static models:AiRating.Useful}">
                                                                                    <Setter Property="Filled" Value="True"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource HistoryThumbButton}"
                                                                Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanRate}"
                                                                ToolTip="This rewrite was not useful"
                                                                AutomationProperties.Name="{Binding ThumbDownName}"
                                                                Click="HistoryThumbDown_Click">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="ThumbDislike24">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Filled" Value="False"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Rating}" Value="{x:Static models:AiRating.NotUseful}">
                                                                                    <Setter Property="Filled" Value="True"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource HistoryThumbButton}"
                                                                Content="&#xE724;"
                                                                Tag="{Binding Id}"
                                                                ToolTip="Report this AI result to the developer"
                                                                AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                                                Visibility="{Binding CanReport, Converter={StaticResource BoolToVisibility}}"
                                                                Click="HistoryReport_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="AI cleanup" Binding="{Binding Cleanup}" Width="Auto">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="ToolTip"
                                                            Value="Time the AI cleanup step took. A dash means cleanup did not run for this dictation, either because it was switched off or because it failed."/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="HistoryEmptyHint"
                                           Text="No dictations yet. Hold your hotkey and speak, then your dictations will appear here."
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="32" TextAlignment="Center" TextWrapping="Wrap"
                                           Style="{StaticResource CardDescription}"/>
                            </Grid>
                        </ui:Card>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <ui:Button x:Name="HistoryClearButton" Content="Clear all"
                                       HorizontalAlignment="Left" Click="HistoryClearButton_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="HistoryCopyButton" Content="Copy text" MinWidth="96"
                                           Margin="0,0,8,0" Click="HistoryCopyButton_Click" IsEnabled="False"/>
                                <ui:Button x:Name="HistoryDeleteButton" Content="Delete" MinWidth="96"
                                           Click="HistoryDeleteButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ============================ Usage ============================ -->
                    <Grid x:Name="SectionUsage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Text="Usage" Style="{StaticResource PageTitle}"/>
                                <TextBlock Style="{StaticResource PageSubtitle}"
                                           Text="How much you've dictated, and words you might add to your dictionary."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ComboBox x:Name="UsagePeriodBox" Width="150" Margin="0,0,8,0"
                                          AutomationProperties.Name="Usage period"
                                          SelectionChanged="UsagePeriodBox_SelectionChanged"/>
                                <ui:Button Content="Refresh" MinWidth="84" Click="UsageRefreshButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,0,14,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1000"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                <TextBlock x:Name="UsageCoverageText" Style="{StaticResource CardDescription}"
                                           Margin="0,0,0,10"/>

                                <ui:Card Padding="18,14" Margin="0,0,0,12">
                                    <UniformGrid Columns="5">
                                        <StackPanel>
                                            <TextBlock x:Name="UsageDictationsText" Style="{StaticResource MetricValue}"/>
                                            <TextBlock Text="dictations" Style="{StaticResource CardDescription}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="UsageWordsText" Style="{StaticResource MetricValue}"/>
                                            <TextBlock Text="words" Style="{StaticResource CardDescription}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="UsageActiveDaysText" Style="{StaticResource MetricValue}"/>
                                            <TextBlock Text="active days" Style="{StaticResource CardDescription}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="UsageSpeechText" Style="{StaticResource MetricValue}"/>
                                            <TextBlock Text="speech" Style="{StaticResource CardDescription}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="UsageAverageText" Style="{StaticResource MetricValue}"/>
                                            <TextBlock Text="words per dictation" Style="{StaticResource CardDescription}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </ui:Card>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Card Grid.Column="0" Padding="18,14" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="UsageAppsTitle" Text="Top apps" Style="{StaticResource CardTitle}"/>
                                            <DataGrid x:Name="UsageAppsGrid" Margin="0,10,0,0" MaxHeight="230"
                                                      AutoGenerateColumns="False" IsReadOnly="True"
                                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                      Background="Transparent" BorderThickness="0"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=UsageAppsTitle}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Dictations" Binding="{Binding Dictations}" Width="Auto"/>
                                                    <DataGridTextColumn Header="Words" Binding="{Binding Words}" Width="Auto"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </ui:Card>
                                    <ui:Card Grid.Column="2" Padding="18,14" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="UsageTrendTitle" Text="Trend" Style="{StaticResource CardTitle}"/>
                                            <!-- An ItemsControl is a Control, so WPF makes it a Tab stop of its own, an
                                                 empty focus rectangle around its items; neither the Aero2 theme nor
                                                 WPF-UI 4.3.0 turns that off. These lists only display, so they take no
                                                 focus, and anything inside them that acts still does. -->
                                            <ItemsControl x:Name="UsageTrendChart" Height="72" Margin="0,10,0,2"
                                                          Focusable="False" AutomationProperties.Name="Trend chart">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="72" Margin="1,0" Background="Transparent"
                                                              ToolTip="{Binding ToolTip}">
                                                            <Border Height="64" MaxWidth="18"
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Bottom"
                                                                    Background="{DynamicResource {x:Static infra:AccentContrastKeys.ChartBar}}"
                                                                    CornerRadius="2,2,0,0"
                                                                    RenderTransformOrigin="0.5,1"
                                                                    SnapsToDevicePixels="True">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleY="{Binding RelativeHeight}"/>
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DataGrid x:Name="UsageTrendGrid" Margin="0,10,0,0" MaxHeight="230"
                                                      AutoGenerateColumns="False" IsReadOnly="True"
                                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                      Background="Transparent" BorderThickness="0"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=UsageTrendTitle}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="*"/>
                                                    <DataGridTextColumn Header="Dictations" Binding="{Binding Dictations}" Width="Auto"/>
                                                    <DataGridTextColumn Header="Words" Binding="{Binding Words}" Width="Auto"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </ui:Card>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Card Grid.Column="0" Padding="18,14" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="UsageKnownTitle" Text="Recognized technologies" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Terms already covered by your enabled dictionary and libraries."
                                                       Style="{StaticResource CardDescription}"/>
                                            <ItemsControl x:Name="UsageKnownTerms" Margin="0,10,0,0" Focusable="False"
                                                          AutomationProperties.LabeledBy="{Binding ElementName=UsageKnownTitle}"/>
                                        </StackPanel>
                                    </ui:Card>
                                    <ui:Card Grid.Column="2" Padding="18,14" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="UsageNovelTitle" Text="Recurring terminology" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Conservative jargon candidates not yet covered by your dictionary."
                                                       Style="{StaticResource CardDescription}"/>
                                            <TextBlock x:Name="UsageNovelEmptyHint"
                                                       Text="No recurring uncovered jargon in this period."
                                                       Style="{StaticResource CardDescription}" Margin="0,10,0,0"/>
                                            <ItemsControl x:Name="UsageNovelTerms" Margin="0,7,0,0"
                                                          Visibility="Collapsed" Focusable="False"
                                                          AutomationProperties.LabeledBy="{Binding ElementName=UsageNovelTitle}">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DictationLabel}"
                                                                           Style="{StaticResource CardDescription}"
                                                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <!-- Every row's button says "Add", so each is named after its
                                                                 term; otherwise Tab reaches a run of identical buttons. -->
                                                            <ui:Button Grid.Column="1" Content="Add" MinWidth="52" Height="28"
                                                                       Margin="12,0,0,0" Padding="10,0"
                                                                       AutomationProperties.Name="{Binding Text, StringFormat='Add {0} to the dictionary'}"
                                                                       Click="UsageNovelTermAddButton_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ui:Card>
                                </Grid>

                                <ui:Card Padding="18,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="AI insight" Style="{StaticResource CardTitle}"/>
                                            <TextBlock x:Name="UsageInsightText" Style="{StaticResource CardDescription}"
                                                       Text="Ask your configured cleanup model for a short summary. Only totals and dictionary term labels are sent."/>
                                        </StackPanel>
                                        <ui:Button x:Name="UsageInsightButton" Grid.Column="1" Content="Generate insight"
                                                   MinWidth="126" Margin="16,0,0,0" VerticalAlignment="Center"
                                                   Click="UsageInsightButton_Click"/>
                                    </Grid>
                                </ui:Card>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================ Diagnostics ============================ -->
                    <Grid x:Name="SectionDiagnostics" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,14" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock Text="Diagnostics" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="Get help, see what went wrong, and check how fast dictation runs."/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,0,14,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1000"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                <TextBlock Text="Get help" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                <TextBlock Text="Save diagnostics..." Style="{StaticResource CardTitle}"/>
                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Saves your logs and a summary of this PC to a zip file you can attach to a report. Logs never contain your dictations, but they do name the app you dictated into, your microphone, and error details."/>
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Content="Save diagnostics..." MinWidth="150" VerticalAlignment="Center" Click="AboutSaveDiagnostics_Click"/>
                                        </Grid>
                                        <Border Height="1" Margin="0,12,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                <TextBlock Text="Report a problem" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Opens GitHub to report a problem or suggest a feature. Don't include dictations, recordings or keys in a public report."/>
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Content="Report a problem" MinWidth="150" VerticalAlignment="Center" Click="GitHubIssueButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <TextBlock Text="Logs folder" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,2,0,0" TextWrapping="Wrap" Text="One file per day, kept for 7 days, recording app events, timings and errors. Logs never contain your dictations, but they do name the app you dictated into, your microphone, and error details. Read one before sharing it."/>
                                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="AboutLogsPathBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" VerticalContentAlignment="Center" FontFamily="Consolas" AutomationProperties.Name="Logs folder"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ui:Button x:Name="AboutCopyLogsButton" Content="Copy" MinWidth="76" Margin="0,0,8,0" Click="AboutCopyLogsPath_Click" ToolTip="Copy this path to the clipboard."/>
                                                <ui:Button Content="Open" MinWidth="76" Click="AboutOpenLogsFolder_Click" ToolTip="Open this folder in File Explorer."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <TextBlock x:Name="FailuresTitle" Text="AI cleanup problems" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                                                        <TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Times AI cleanup couldn't finish in the last 7 days, so Scribe typed what it heard instead."/>
                                            <TextBlock x:Name="FailuresCountText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:Button x:Name="ClearFailuresButton" Grid.Column="1" Content="Clear this list..." MinWidth="130" VerticalAlignment="Center" Click="ClearFailuresButton_Click"/>
                                    </Grid>
                                </ui:Card>
                                <ui:Card Padding="0" Style="{StaticResource PanelCard}">
                                    <Grid>
                                        <DataGrid x:Name="FailuresGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" settings:NestedScrollWheel.ForwardToPage="True" AutomationProperties.LabeledBy="{Binding ElementName=FailuresTitle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="When" Binding="{Binding When}" Width="Auto"/>
                                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="Auto"/>
                                                <DataGridTextColumn Header="What happened" Binding="{Binding Reason}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock x:Name="NoFailuresText" Text="No AI cleanup failures recorded in the last 7 days." HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardDescription}" Margin="16" Visibility="Collapsed"/>
                                    </Grid>
                                </ui:Card>

                                <TextBlock Text="Speed" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="How long each step takes" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="StatsSummaryText" Style="{StaticResource CardDescription}" Margin="0,2,0,0" Text="No dictations in the last 7 days."/>
                                        <Grid x:Name="StatsGrid" Margin="0,12,0,0" Visibility="Collapsed">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Speech recognition" Style="{StaticResource MetricLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="AI cleanup" Style="{StaticResource MetricLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Both" Style="{StaticResource MetricLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Typical" Style="{StaticResource MetricLabel}" Margin="0,8,12,0"/>
                                            <TextBlock x:Name="StatDecodeP50" Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricValue}" Margin="0,8,12,0"/>
                                            <TextBlock x:Name="StatCleanupP50" Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricValue}" Margin="0,8,12,0"/>
                                            <TextBlock x:Name="StatCombinedP50" Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricValue}" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="19 in 20 finish within" Style="{StaticResource MetricLabel}" Margin="0,8,12,0"/>
                                            <TextBlock x:Name="StatDecodeP95" Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricValue}" Margin="0,8,12,0"/>
                                            <TextBlock x:Name="StatCleanupP95" Grid.Row="2" Grid.Column="2" Style="{StaticResource MetricValue}" Margin="0,8,12,0"/>
                                            <TextBlock x:Name="StatCombinedP95" Grid.Row="2" Grid.Column="3" Style="{StaticResource MetricValue}" Margin="0,8,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                                <ui:CardExpander x:Name="SpeedDetailsExpander" IsExpanded="False" AutomationProperties.Name="Speed details">
                                    <ui:CardExpander.Header><StackPanel><TextBlock Text="Speed details" Style="{StaticResource CardTitle}"/><TextBlock Style="{StaticResource CardDescription}" Margin="0,2,0,0" Text="Average, fastest and slowest runs by step."/></StackPanel></ui:CardExpander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <UniformGrid Columns="4" Margin="0,0,0,12">
                                            <StackPanel><TextBlock x:Name="StatWeekDictations" Style="{StaticResource MetricValue}"/><TextBlock Text="dictations" Style="{StaticResource MetricLabel}"/></StackPanel>
                                            <StackPanel><TextBlock x:Name="StatWeekSpeech" Style="{StaticResource MetricValue}"/><TextBlock Text="speech captured" Style="{StaticResource MetricLabel}"/></StackPanel>
                                            <StackPanel><TextBlock x:Name="StatLongestDictation" Style="{StaticResource MetricValue}"/><TextBlock Text="longest dictation" Style="{StaticResource MetricLabel}"/></StackPanel>
                                            <StackPanel><TextBlock x:Name="StatBestPace" Style="{StaticResource MetricValue}"/><TextBlock Text="best pace" Style="{StaticResource MetricLabel}"/></StackPanel>
                                        </UniformGrid>
                                        <TextBlock x:Name="DecodeSpeedTitle" Text="Speech recognition" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="DecodeSummaryHint" Style="{StaticResource CardDescription}" Margin="0,2,0,0" Text="Speech recognition time only. AI cleanup isn't counted here."/>
                                        <UniformGrid x:Name="DecodeMetricsGrid" Columns="3" Margin="0,8,0,12" Visibility="Collapsed"><StackPanel><TextBlock x:Name="StatDecodeAverage" Style="{StaticResource MetricValue}"/><TextBlock Text="average" Style="{StaticResource MetricLabel}"/></StackPanel><StackPanel><TextBlock x:Name="StatDecodeMin" Style="{StaticResource MetricValue}"/><TextBlock Text="fastest" Style="{StaticResource MetricLabel}"/></StackPanel><StackPanel><TextBlock x:Name="StatDecodeMax" Style="{StaticResource MetricValue}"/><TextBlock Text="slowest" Style="{StaticResource MetricLabel}"/></StackPanel></UniformGrid>
                                        <TextBlock x:Name="DecodeNoDataText" Style="{StaticResource CardDescription}" Text="No speech recognition runs in this period yet."/>
                                        <TextBlock x:Name="CleanupSpeedTitle" Text="AI cleanup" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="CleanupSummaryHint" Style="{StaticResource CardDescription}" Margin="0,2,0,0" Text="AI cleanup time after speech recognition finishes."/>
                                        <UniformGrid x:Name="CleanupMetricsGrid" Columns="3" Margin="0,8,0,12" Visibility="Collapsed"><StackPanel><TextBlock x:Name="StatCleanupAverage" Style="{StaticResource MetricValue}"/><TextBlock Text="average" Style="{StaticResource MetricLabel}"/></StackPanel><StackPanel><TextBlock x:Name="StatCleanupMin" Style="{StaticResource MetricValue}"/><TextBlock Text="fastest" Style="{StaticResource MetricLabel}"/></StackPanel><StackPanel><TextBlock x:Name="StatCleanupMax" Style="{StaticResource MetricValue}"/><TextBlock Text="slowest" Style="{StaticResource MetricLabel}"/></StackPanel></UniformGrid>
                                        <TextBlock x:Name="CleanupNoDataText" Style="{StaticResource CardDescription}" Text="No AI cleanup runs in this period yet."/>
                                        <TextBlock x:Name="CombinedSpeedTitle" Text="Recognition plus AI cleanup" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="CombinedSummaryHint" Style="{StaticResource CardDescription}" Margin="0,2,0,0" Text="Recognition plus AI cleanup."/>
                                        <UniformGrid x:Name="CombinedMetricsGrid" Columns="3" Margin="0,8,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="StatCombinedAverage" Style="{StaticResource MetricValue}"/><TextBlock Text="average" Style="{StaticResource MetricLabel}"/></StackPanel><StackPanel><TextBlock x:Name="StatCombinedMin" Style="{StaticResource MetricValue}"/><TextBlock Text="fastest" Style="{StaticResource MetricLabel}"/></StackPanel><StackPanel><TextBlock x:Name="StatCombinedMax" Style="{StaticResource MetricValue}"/><TextBlock Text="slowest" Style="{StaticResource MetricLabel}"/></StackPanel></UniformGrid>
                                        <TextBlock x:Name="CombinedNoDataText" Style="{StaticResource CardDescription}" Text="No cleanup-enabled runs in this period yet."/>
                                    </StackPanel>
                                </ui:CardExpander>

                                <TextBlock Text="This PC" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}"><StackPanel><TextBlock x:Name="SystemCapabilityText" Style="{StaticResource CardDescription}" Margin="0,2,0,0" Text="Checking hardware..."/><TextBlock x:Name="SystemCapabilityAdviceText" Style="{StaticResource CardDescription}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource SystemFillColorCautionBrush}"/></StackPanel></ui:Card>

                                <TextBlock Text="Where Scribe keeps your data" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                                                                <TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Text="Never send or share this file. It holds everything you've dictated and your saved keys. To delete dictations, use History."/>
                                        <TextBlock x:Name="AboutDataPathWarning" Style="{StaticResource CardDescription}" Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                        <TextBlock x:Name="AboutDataFileTitle" Text="Scribe data file" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                        <TextBlock x:Name="AboutDataFileHintText" Style="{StaticResource CardDescription}" Margin="0,2,0,0"/>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="AboutDatabasePathBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" VerticalContentAlignment="Center" FontFamily="Consolas" AutomationProperties.LabeledBy="{Binding ElementName=AboutDataFileTitle}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ui:Button x:Name="AboutCopyDatabaseButton" Content="Copy" MinWidth="76" Margin="0,0,8,0" Click="AboutCopyDatabasePath_Click" ToolTip="Copy this path to the clipboard."/>
                                                <ui:Button Content="Open folder" MinWidth="104" Click="AboutOpenDataFolder_Click" ToolTip="Open the containing folder in File Explorer."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================ About ============================ -->
                    <Grid x:Name="SectionAbout" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,8,0,16" MaxWidth="1000" HorizontalAlignment="Left">
                            <TextBlock Text="About" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="Version, updates, help, privacy and feedback."/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,0,14,4">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1000"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                <ui:Card Style="{StaticResource SettingsCard}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="pack://application:,,,/Assets/scribe-mark.png" Width="72" Height="72" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Scribe"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Scribe" Style="{StaticResource PageTitle}"/>
                                            <TextBlock x:Name="AboutVersionText" Text="Version" Style="{StaticResource CardDescription}" Margin="0,3,0,0"/>
                                            <TextBlock Text="Private push-to-talk dictation for Windows" Style="{StaticResource CardDescription}" Margin="0,6,0,0"/>
                                            <TextBlock Text="Updates" Style="{StaticResource CardTitle}" Margin="0,18,0,0"/>
                                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CardDescription}" Margin="0,2,0,0" Text="Scribe does not look for updates until you ask."/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <ui:Button x:Name="UpdateCheckButton" Content="Check for updates" MinWidth="130" Margin="0,0,8,0" Click="UpdateCheckButton_Click"/>
                                                <ui:Button x:Name="UpdateApplyButton" Content="Restart to update" MinWidth="130" Visibility="Collapsed" Click="UpdateApplyButton_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <TextBlock Text="Get help" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="Having a problem? Save diagnostics and attach the file when you report it." Style="{StaticResource CardDescription}"/><WrapPanel Margin="0,12,0,0"><ui:Button Content="Report a problem" MinWidth="130" Margin="0,0,8,8" Click="GitHubIssueButton_Click"/><ui:Button Content="Save diagnostics..." MinWidth="150" Margin="0,0,8,8" Click="AboutSaveDiagnostics_Click"/><ui:Button Content="Open Diagnostics" MinWidth="140" Margin="0,0,8,8" Click="AboutOpenDiagnostics_Click"/><ui:Button Content="Show the welcome again" MinWidth="180" Margin="0,0,8,8" Click="AboutShowWelcomeButton_Click"/></WrapPanel></StackPanel></ui:Card>

                                <TextBlock Text="Privacy" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Speech recognition runs on this PC, and your audio never leaves it. AI cleanup is optional, and online services receive text only while you use them."/></StackPanel><ui:Button Grid.Column="1" Content="Read the privacy policy" MinWidth="170" VerticalAlignment="Center" Click="PrivacyPolicyButton_Click"/></Grid></ui:Card>

                                <TextBlock Text="Feedback" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Report an AI result..." Style="{StaticResource CardTitle}"/><TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0" TextWrapping="Wrap" Text="If AI cleanup wrote something inappropriate, tell us. Your mail app opens with the report so you can read it first. Scribe sends nothing by itself. You can also report a result from History."/></StackPanel><ui:Button Grid.Column="1" Content="Report an AI result..." VerticalAlignment="Center" MinWidth="150" Click="AboutReportAiContent_Click"/></Grid><Border Height="1" Margin="0,12,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Rate Scribe in the Microsoft Store" Style="{StaticResource CardTitle}"/><TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0" Text="Ratings and reviews are handled by the Microsoft Store."/></StackPanel><ui:Button Grid.Column="1" Content="Rate" VerticalAlignment="Center" MinWidth="100" Click="AboutRateInStore_Click"/></Grid></StackPanel></ui:Card>

                                <TextBlock Text="Support Scribe" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Star Scribe on GitHub" Style="{StaticResource CardTitle}"/><TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0" TextWrapping="Wrap" Text="A GitHub star helps other people discover private, offline dictation."/></StackPanel><ui:Button Grid.Column="1" Content="Open GitHub" MinWidth="130" VerticalAlignment="Center" Click="GitHubStarButton_Click"/></Grid><Border Height="1" Margin="0,12,0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/><TextBlock Text="Share Scribe" Style="{StaticResource CardTitle}"/><TextBlock Style="{StaticResource CardDescription}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Send this link to anyone who wants private, offline dictation. It opens the Scribe listing in the Microsoft Store."/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBox x:Name="AboutStoreLinkBox" Grid.Column="0" IsReadOnly="True" VerticalAlignment="Center" AutomationProperties.Name="Microsoft Store link"/><ui:Button Grid.Column="1" Content="Copy link" MinWidth="100" Margin="8,0,0,0" Click="AboutCopyStoreLink_Click" ToolTip="Copy the Store link to the clipboard."/></Grid></StackPanel></ui:Card>

                                <TextBlock Text="Source" Style="{StaticResource SectionHeader}"/>
                                <ui:Card Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,20,0"><TextBlock Text="Scribe is open source under the MIT License." Style="{StaticResource CardDescription}" Margin="0,4,0,0"/></StackPanel><ui:Button Grid.Column="1" Content="View source" MinWidth="110" VerticalAlignment="Center" Click="GitHubSourceButton_Click"/></Grid></ui:Card>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>                </Grid>

                <!-- Footer: explicit save model, always visible -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <ui:Button x:Name="SaveButton" Content="Save" Appearance="Primary"
                               MinWidth="96" Margin="0,0,8,0" Click="SaveButton_Click"
                               ToolTip="Save your changes and keep this window open."/>
                    <ui:Button x:Name="SaveCloseButton" Content="Save and close"
                               MinWidth="120" Margin="0,0,8,0" Click="SaveCloseButton_Click"
                               ToolTip="Save your changes and close the window."/>
                    <ui:Button x:Name="CancelButton" Content="Cancel"
                               MinWidth="96" Click="CancelButton_Click" IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
