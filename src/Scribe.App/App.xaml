<Application x:Class="Scribe.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Scribe.App"
             xmlns:infra="clr-namespace:Scribe.App.Infrastructure"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Scribe's own keys for colours on coloured fills, for links and for its selection cues.
                 AccentContrastResources writes them for every theme before the first window. Until then the flag is off,
                 so no Scribe trigger that replaces a WPF-UI or WPF colour is active; the keys hold no selection cue, and
                 black on WPF-UI's palette fills, which reads on each of them in both themes. -->
            <sys:Boolean x:Key="{x:Static infra:AccentContrastKeys.Applies}">False</sys:Boolean>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.CautionBadgeForeground}" Color="#FF000000"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.InfoBadgeForeground}" Color="#FF000000"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.DangerBadgeForeground}" Color="#FF000000"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.SuccessBadgeForeground}" Color="#FF000000"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.DangerButtonForeground}" Color="#FF000000"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.PrimaryPressedForeground}" Color="#FF000000"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.DangerPressedForeground}" Color="#FF000000"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.SecondaryPressedForeground}" Color="#FF000000"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.HyperlinkForeground}" Color="#FF0066CC"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.HyperlinkHoverForeground}" Color="#FF0066CC"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.SelectedRowOutline}" Color="Transparent"/>
            <FontWeight x:Key="{x:Static infra:AccentContrastKeys.SelectedRowNameWeight}">Normal</FontWeight>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.SelectedItemOutline}" Color="Transparent"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.SelectedItemForeground}" Color="#FF000000"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.SelectedItemIndicator}" Color="Transparent"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.ChartBar}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
            <SolidColorBrush x:Key="{x:Static infra:AccentContrastKeys.ChartBarCurrent}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>

            <sys:Double x:Key="ScribeFontCaption">12</sys:Double>
            <sys:Double x:Key="ScribeFontBody">14</sys:Double>
            <sys:Double x:Key="ScribeFontBodyLarge">16</sys:Double>
            <sys:Double x:Key="ScribeFontSubtitle">20</sys:Double>
            <sys:Double x:Key="ScribeFontIconLarge">22</sys:Double>
            <sys:Double x:Key="ScribeFontTitle">26</sys:Double>
            <sys:Double x:Key="ScribeFontDisplay">68</sys:Double>
            <sys:Double x:Key="ControlContentThemeFontSize">14</sys:Double>
            <sys:Double x:Key="TextControlThemeFontSize">14</sys:Double>
            <sys:Double x:Key="DefaultDataGridFontSize">14</sys:Double>
            <sys:Double x:Key="TitleBarThemeFontSize">12</sys:Double>
            <sys:Double x:Key="InfoBarTitleThemeFontSize">14</sys:Double>
            <sys:Double x:Key="InfoBarMessageThemeFontSize">14</sys:Double>

            <LinearGradientBrush x:Key="ScribePillFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A2744" Offset="0"/>
                <GradientStop Color="#0E1830" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ScribePillListeningEdgeBrush" Color="#71ADFF"/>
            <SolidColorBrush x:Key="ScribeLevelTipBrush" Color="#93C0FE"/>
            <SolidColorBrush x:Key="ScribeSignalBrush" Color="#1C83FE"/>

            <!-- A link. WPF-UI 4.3.0 has no style for Hyperlink. In a light or dark theme Scribe uses the planned
                 accent text shades for links; in a contrast theme the flag is off and WPF's style draws the
                 theme's link colours, as before. No BasedOn: WPF's own style still applies under this one. -->
            <Style TargetType="Hyperlink">
                <Setter Property="infra:AccentContrastFlag.Applies" Value="{DynamicResource {x:Static infra:AccentContrastKeys.Applies}}"/>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                            <Condition Property="IsEnabled" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static infra:AccentContrastKeys.HyperlinkForeground}}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="infra:AccentContrastFlag.Applies" Value="True"/>
                            <Condition Property="IsEnabled" Value="True"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static infra:AccentContrastKeys.HyperlinkHoverForeground}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!-- Don't add an implicit style for a type X here with BasedOn="{StaticResource {x:Type X}}". In this
                 compiled application dictionary that reference resolves to the style being defined, which WPF returns
                 as null, so X silently loses WPF-UI's whole style (every title bar button once shrank to an 8 px
                 square with no command). Moving the style into a dictionary of its own under MergedDictionaries does
                 not help either: the compiled App.xaml then also holds an empty entry under the same key, and the
                 first X created gets no style. Build such a style in code on WPF-UI's own instance, as
                 Infrastructure/TitleBarButtonNames.cs does. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
