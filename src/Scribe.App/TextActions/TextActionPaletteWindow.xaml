<ui:FluentWindow x:Class="Scribe.App.TextActions.TextActionPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Scribe actions"
        Width="440" SizeToContent="Height" MaxHeight="660"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        WindowCornerPreference="Round"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <ui:FluentWindow.Resources>

        <!--
            Design tokens. Kept as named resources rather than inline literals so radius, spacing and
            motion stay consistent across every element and can be retuned in one place. Motion
            values follow current practice: entrances decelerate and land around 200 ms, exits
            accelerate and are shorter, and nothing crosses 300 ms.
        -->
        <CornerRadius x:Key="RadiusWindow">14</CornerRadius>
        <CornerRadius x:Key="RadiusRow">10</CornerRadius>
        <CornerRadius x:Key="RadiusChip">7</CornerRadius>
        <Thickness x:Key="PadPanel">16,14</Thickness>

        <Duration x:Key="DurHover">0:0:0.12</Duration>
        <Duration x:Key="DurEnter">0:0:0.20</Duration>

        <!-- Emphasized decelerate: fast start, soft landing. The standard entrance curve. -->
        <CubicEase x:Key="EaseEnter" EasingMode="EaseOut"/>

        <!-- Per-group accent. Colour is the fastest way to tell three kinds of action apart, and it
             keeps working for anyone who reads the list by shape rather than by word. -->
        <SolidColorBrush x:Key="AccentRewrite" Color="#0A84FF"/>
        <SolidColorBrush x:Key="AccentFormat" Color="#BF5AF2"/>
        <SolidColorBrush x:Key="AccentVocabulary" Color="#30D158"/>

        <Style TargetType="TextBlock" x:Key="GroupLabel">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="18,14,0,6"/>
        </Style>

        <!--
            An action row. Two lines by design: the label alone does not tell you what "Rewrite for an
            AI agent" will do to your text, and a palette exists precisely because it has the room a
            context menu does not. The accent bar on the left grows on hover, which reads as the row
            leaning toward you without any layout shift.
        -->
        <Style TargetType="Button" x:Key="ActionRow">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row"
                                CornerRadius="{StaticResource RadiusRow}"
                                Background="Transparent"
                                Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Accent bar. Height animates rather than width so the text never
                                     moves; a row that shifts on hover feels unstable. -->
                                <Border x:Name="Accent" Grid.Column="0"
                                        Width="3" Height="16" CornerRadius="2"
                                        VerticalAlignment="Center"
                                        Margin="0,0,11,0"
                                        Background="{TemplateBinding Tag}"
                                        Opacity="0.45"/>

                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Accent"
                                                             Storyboard.TargetProperty="Height"
                                                             To="30" Duration="{StaticResource DurHover}"
                                                             EasingFunction="{StaticResource EaseEnter}"/>
                                            <DoubleAnimation Storyboard.TargetName="Accent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="{StaticResource DurHover}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Accent"
                                                             Storyboard.TargetProperty="Height"
                                                             To="16" Duration="{StaticResource DurHover}"/>
                                            <DoubleAnimation Storyboard.TargetName="Accent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.45" Duration="{StaticResource DurHover}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Keyboard focus gets the same treatment as hover, so arrowing through
                                 the list is as legible as pointing at it. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="Accent" Property="Height" Value="30"/>
                                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- Entrance: fade plus a short rise. Reads as the panel arriving rather than blinking on. -->
    <ui:FluentWindow.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shell"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="{StaticResource DurEnter}"/>
                    <DoubleAnimation Storyboard.TargetName="ShellLift"
                                     Storyboard.TargetProperty="Y"
                                     From="10" To="0" Duration="{StaticResource DurEnter}"
                                     EasingFunction="{StaticResource EaseEnter}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </ui:FluentWindow.Triggers>

    <Border x:Name="Shell"
            CornerRadius="{StaticResource RadiusWindow}"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderThickness="1"
            BorderBrush="#26FFFFFF">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ShellLift"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: what was captured, and where it would be sent. The excerpt is the only
                 confirmation the user gets that Scribe read the text they meant. -->
            <Border Grid.Row="0" Padding="{StaticResource PadPanel}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{StaticResource AccentRewrite}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="CountText" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Border x:Name="DestinationBadge" HorizontalAlignment="Right"
                                CornerRadius="{StaticResource RadiusChip}" Padding="8,3"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderThickness="1" BorderBrush="#1AFFFFFF">
                            <TextBlock x:Name="DestinationText" FontSize="10" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PreviewText" Margin="0,9,0,0"
                               FontSize="12" LineHeight="17" TextTrimming="CharacterEllipsis"
                               MaxHeight="36" TextWrapping="Wrap" Opacity="0.75"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Filter. A palette that cannot be typed at is a menu; this is what makes it a
                 palette, and it works here only because this window takes focus. -->
            <Border x:Name="FilterHost" Grid.Row="1" Padding="14,0,14,10">
                <Border CornerRadius="{StaticResource RadiusRow}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderThickness="1" BorderBrush="#1AFFFFFF"
                        Padding="11,7">
                    <Grid>
                        <TextBlock x:Name="FilterPlaceholder" FontSize="12" Opacity="0.45"
                                   Text="Type to filter actions"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="FilterBox" FontSize="12" BorderThickness="0"
                                 Background="Transparent" Padding="0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                 TextChanged="OnFilterChanged"/>
                    </Grid>
                </Border>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                    <StackPanel x:Name="ActionList" Margin="0,0,0,10"/>
                </ScrollViewer>

                <StackPanel x:Name="BusyPanel" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,34">
                    <ui:ProgressRing IsIndeterminate="True" Width="34" Height="34"/>
                    <TextBlock x:Name="BusyText" Margin="0,14,0,0" HorizontalAlignment="Center"
                               FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Grid x:Name="ResultPanel" Visibility="Collapsed" Margin="16,4,16,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="3" Height="13" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource AccentRewrite}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ResultHeading" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" Opacity="0.7"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Row="1" CornerRadius="{StaticResource RadiusRow}" Padding="12"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderThickness="1" BorderBrush="#1AFFFFFF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="290">
                            <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="12.5" AcceptsReturn="True"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Padding="16,11"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#14FFFFFF">
                <Grid>
                    <TextBlock x:Name="HintText" FontSize="11" VerticalAlignment="Center" Opacity="0.55"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <StackPanel x:Name="ResultButtons" Orientation="Horizontal"
                                HorizontalAlignment="Right" Visibility="Collapsed">
                        <ui:Button x:Name="DiscardButton" Content="Discard" Margin="0,0,8,0"
                                   Click="OnDiscard"/>
                        <ui:Button x:Name="CopyButton" Content="Copy" Margin="0,0,8,0"
                                   Click="OnCopyInstead"/>
                        <ui:Button x:Name="ReplaceButton" Content="Replace" Appearance="Primary"
                                   Click="OnReplace"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
