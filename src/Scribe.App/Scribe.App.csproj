<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Scribe.Core\Scribe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the brand and state variants inside Scribe.exe. Velopack replaces the executable as
         one unit, so upgrades cannot leave an old tray-icon file beside the new application. -->
    <EmbeddedResource Include="Assets\scribe.ico" LogicalName="Scribe.App.Assets.scribe.ico" />
    <EmbeddedResource Include="Assets\scribe-recording.ico" LogicalName="Scribe.App.Assets.scribe-recording.ico" />
    <EmbeddedResource Include="Assets\scribe-processing.ico" LogicalName="Scribe.App.Assets.scribe-processing.ico" />
    <EmbeddedResource Include="Assets\scribe-paused.ico" LogicalName="Scribe.App.Assets.scribe-paused.ico" />
  </ItemGroup>

  <!-- Velopack's install/update hooks must run before WPF starts, so we use an explicit Program.Main
       (StartupObject) instead of the auto-generated App entry point. That requires App.xaml to be a
       Page rather than the ApplicationDefinition (which would emit a second Main). -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <!-- The offline speech models are a hard runtime dependency. They live in source under .\models
       (fetched by scripts/Download-Models.ps1, gitignored) and are copied next to the executable so
       ModelLocator finds them exe-local during development AND they ship inside the published /
       Velopack installer, giving a fully-offline first run with no parent-directory probing. -->
  <ItemGroup>
    <None Remove="models\**" />
    <None Include="models\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-version-specific TFM so the app can call WinRT (Windows.Services.Store) for
         Microsoft Store update checks. This is the documented .NET 6+ approach; the
         Microsoft.Windows.SDK.Contracts package is explicitly not recommended here.
         SupportedOSPlatformVersion is the Windows 11 floor (build 22000) because that is what
         Scribe actually targets. Scribe optimizes for current Windows rather than carrying a
         compatibility story for Windows 10: the higher floor is what lets the platform analyzer
         allow Windows 11 APIs without a guard, and it clears the build 18362 minimum that WinML
         needs to acquire hardware execution providers for GPU and NPU acceleration. -->
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Scribe.App</RootNamespace>
    <AssemblyName>Scribe</AssemblyName>
    <StartupObject>Scribe.App.Program</StartupObject>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\scribe.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
