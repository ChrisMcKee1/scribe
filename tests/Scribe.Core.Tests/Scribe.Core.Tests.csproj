<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- The app's SDK at its central version, only so TraceLogBridgeTests can hold the listener to what the SDK decides. -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scribe.Core\Scribe.Core.csproj" />
    <ProjectReference Include="..\..\tools\Scribe.Evals\Scribe.Evals.csproj" />
    <!-- Built beside the tests, never referenced: AppendOnlyLogTests starts it twice to append from two processes. -->
    <ProjectReference Include="..\Scribe.LogAppendChild\Scribe.LogAppendChild.csproj" ReferenceOutputAssembly="false" />
    <!-- Reflection-based dialog checks load the real BAML without starting the app, its hooks, or its data services. -->
    <ProjectReference Include="..\..\src\Scribe.App\Scribe.App.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <!-- The overlay's writer of the shared log (it has no Scribe.Core reference, so it is compiled here from its source). -->
    <Compile Include="..\..\src\Scribe.Overlay\Logging\OverlayLog.cs" Link="Linked\OverlayLog.cs" />
    <Compile Include="..\..\tools\Scribe.Benchmarks\BoundedChildProcess.cs" Link="Linked\BoundedChildProcess.cs" />
    <Compile Include="..\..\src\Scribe.App\Settings\DataGridTextEdit.cs" Link="Linked\DataGridTextEdit.cs" />
    <Compile Include="..\..\src\Scribe.App\Settings\DataGridTypingTab.cs" Link="Linked\DataGridTypingTab.cs" />
  </ItemGroup>

</Project>