{
  "description": "LibraryTermKey: how the Windows build decides that two spoken forms are one library term, and the form the editor commits a typed Spoken value in. A key is the spoken form trimmed (char.IsWhiteSpace, the Unicode White_Space set), inner white space kept, compared with .NET's StringComparison.OrdinalIgnoreCase: per code point simple uppercase, with no normalization. It is exactly the key 0.4.3 composed libraries by, so an older file's row with a double space or a tab inside it keeps 0.4.3's behaviour (review finding A10). The commit form (Normalize) is the spoken form trimmed with every inner run of white space replaced by one U+0020; everything the editor commits is in that form, so for it the key and a collapsing comparison agree. Shared with the macOS port, which must give the same answers; the notes mark the pairs where Swift's lowercased() differs. Checked against .NET 10 by tests/Scribe.Core.Tests/Libraries/LibraryTermKeyTests.cs.",
  "commitForm": [
    { "input": "get hub", "expected": "get hub", "note": "already in commit form" },
    { "input": "  get hub  ", "expected": "get hub", "note": "trimmed" },
    { "input": "get  hub", "expected": "get hub", "note": "two spaces" },
    { "input": "get\thub", "expected": "get hub", "note": "tab" },
    { "input": "get \t hub", "expected": "get hub", "note": "mixed run" },
    { "input": "get\r\nhub", "expected": "get hub", "note": "line break" },
    { "input": "get\u00A0hub", "expected": "get hub", "note": "no-break space" },
    { "input": "get\u2003hub", "expected": "get hub", "note": "em space" },
    { "input": "\u3000get hub\u3000", "expected": "get hub", "note": "ideographic space" },
    { "input": "get\u2028hub", "expected": "get hub", "note": "line separator" },
    { "input": "get\u0085hub", "expected": "get hub", "note": "next line" },
    { "input": "get\u200Bhub", "expected": "get\u200Bhub", "note": "zero width space is not white space" },
    { "input": "\uFEFFget hub", "expected": "\uFEFFget hub", "note": "a byte order mark is not white space" },
    { "input": "get\u180Ehub", "expected": "get\u180Ehub", "note": "Mongolian vowel separator is not white space in current Unicode" },
    { "input": "  GitHub   Copilot ", "expected": "GitHub Copilot", "note": "case is kept" },
    { "input": "", "expected": "", "note": "empty" },
    { "input": " \t\r\n ", "expected": "", "note": "only white space" },
    { "input": null, "expected": "", "note": "null" }
  ],
  "key": [
    { "input": "get hub", "expected": "get hub", "note": "already trimmed" },
    { "input": "  get hub  ", "expected": "get hub", "note": "edges trimmed" },
    { "input": "\t get hub\r\n", "expected": "get hub", "note": "tab and line break at the edges" },
    { "input": "\u00A0get hub\u3000", "expected": "get hub", "note": "no-break and ideographic space at the edges" },
    { "input": "get  hub", "expected": "get  hub", "note": "inner double space kept" },
    { "input": "get\thub", "expected": "get\thub", "note": "inner tab kept" },
    { "input": "get\u00A0hub", "expected": "get\u00A0hub", "note": "inner no-break space kept" },
    { "input": "get\r\nhub", "expected": "get\r\nhub", "note": "inner line break kept" },
    { "input": "\u200Bget hub", "expected": "\u200Bget hub", "note": "zero width space is not trimmed" },
    { "input": "  GitHub   Copilot ", "expected": "GitHub   Copilot", "note": "case and inner run kept" },
    { "input": "", "expected": "", "note": "empty" },
    { "input": " \t\r\n ", "expected": "", "note": "only white space" },
    { "input": null, "expected": "", "note": "null" }
  ],
  "same": [
    { "a": "GitHub", "b": "github", "same": true, "note": "ASCII case" },
    { "a": "get hub", "b": "  Get Hub\t", "same": true, "note": "case and edge white space" },
    { "a": "get hub", "b": "Get  Hub", "same": false, "note": "an inner double space is part of the key, as in 0.4.3" },
    { "a": "get hub", "b": "get\thub", "same": false, "note": "an inner tab is part of the key" },
    { "a": "get hub", "b": "get\u00A0hub", "same": false, "note": "an inner no-break space is part of the key" },
    { "a": "get hub", "b": "get\nhub", "same": false, "note": "an inner line break is part of the key" },
    { "a": "get  hub", "b": "GET  HUB", "same": true, "note": "the same irregular run in both" },
    { "a": "get  hub", "b": "get   hub", "same": false, "note": "runs of different lengths" },
    { "a": "get hub", "b": "gethub", "same": false, "note": "white space is not removed" },
    { "a": "get hub", "b": "get-hub", "same": false, "note": "punctuation counts" },
    { "a": "get hub", "b": "get\u200Bhub", "same": false, "note": "zero width space counts" },
    { "a": "caf\u00E9", "b": "cafe\u0301", "same": false, "note": "no Unicode normalization" },
    { "a": "\u212A", "b": "k", "same": false, "note": "Kelvin sign; Swift lowercased() says same" },
    { "a": "\u212A", "b": "K", "same": false, "note": "Kelvin sign against capital K" },
    { "a": "\u212B", "b": "\u00E5", "same": false, "note": "Angstrom sign; Swift lowercased() says same" },
    { "a": "\u00DF", "b": "SS", "same": false, "note": "sharp s has no simple uppercase" },
    { "a": "\u00DF", "b": "\u1E9E", "same": false, "note": "capital sharp s; Swift lowercased() says same" },
    { "a": "\u0130", "b": "i", "same": false, "note": "dotted capital I" },
    { "a": "\u0130", "b": "I", "same": false, "note": "dotted capital I against I" },
    { "a": "\u0131", "b": "I", "same": false, "note": "dotless i does not map to ASCII in .NET" },
    { "a": "\u0131", "b": "i", "same": false, "note": "dotless i against i" },
    { "a": "\u017F", "b": "s", "same": false, "note": "long s does not map to ASCII in .NET" },
    { "a": "\u03C2", "b": "\u03C3", "same": true, "note": "final sigma and sigma; Swift lowercased() says different" },
    { "a": "\u03C2", "b": "\u03A3", "same": true, "note": "final sigma and capital sigma" },
    { "a": "\u1E9B", "b": "\u1E61", "same": true, "note": "long s with dot above and s with dot above" },
    { "a": "\u00C5", "b": "\u00E5", "same": true, "note": "Latin-1 case pair" },
    { "a": "\u01C5", "b": "\u01C4", "same": true, "note": "title case digraph and upper" },
    { "a": "\u01C5", "b": "\u01C6", "same": true, "note": "title case digraph and lower" },
    { "a": "\u1F88", "b": "\u1F80", "same": true, "note": "Greek with prosgegrammeni and ypogegrammeni" },
    { "a": "\uFF27\uFF29\uFF34", "b": "\uFF47\uFF49\uFF54", "same": true, "note": "full-width Latin" },
    { "a": "\u13A0", "b": "\uAB70", "same": true, "note": "Cherokee" },
    { "a": "\u10C7", "b": "\u2D27", "same": true, "note": "Georgian" },
    { "a": "\uD801\uDC00", "b": "\uD801\uDC28", "same": true, "note": "Deseret, outside the Basic Multilingual Plane" }
  ]
