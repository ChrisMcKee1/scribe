<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Scribe.Evals</RootNamespace>
    <AssemblyName>Scribe.Evals</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Internal dev tool: never packed, never published with the app. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scribe.Core\Scribe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools/Scribe.StyleEval reuses this project's Azure Responses wiring rather than standing up
         a second provider path. Scribe.Core grants internals access to Scribe.Evals and not to
         Scribe.StyleEval, so the bridge has to run through here. Side-testing only; neither project
         is published by build/pack.ps1. -->
    <InternalsVisibleTo Include="Scribe.StyleEval" />
    <InternalsVisibleTo Include="Scribe.StyleEval.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- Eval framework stays in this tool only (PrivateAssets=all): it must not flow into the
         app or become a shipped dependency. -->
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
