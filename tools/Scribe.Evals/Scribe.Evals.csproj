<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Scribe.Evals</RootNamespace>
    <AssemblyName>Scribe.Evals</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Internal dev tool: never packed, never published with the app. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scribe.Core\Scribe.Core.csproj" />
    <InternalsVisibleTo Include="Scribe.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- PrivateAssets=all keeps this project's own reference from flowing anywhere. The package still
         ships with the app, because Microsoft.Agents.AI and Microsoft.Agents.AI.OpenAI depend on it,
         so it moves with the Microsoft.Extensions.AI set in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
