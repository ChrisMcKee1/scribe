<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the deterministic checkers in tools/Scribe.StyleEval.

    SIDE-TESTING ONLY, exactly like the project it grades: build/pack.ps1 publishes src/Scribe.App
    and src/Scribe.Overlay and nothing else, so nothing under tools/ can reach a user's machine.

    Why this project exists at all: a buggy checker silently invalidates a ten thousand cell run.
    A false failure sends the maintainer rewriting an instruction set that was already correct, and
    a false pass hides a real weakness. The checkers are the measuring instrument, so they are the
    one part of the suite that has to be calibrated against fixtures with known answers.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Scribe.StyleEval.Tests</RootNamespace>
    <AssemblyName>Scribe.StyleEval.Tests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The checkers under test. Scribe.StyleEval is an Exe; referencing it as a library is what
         lets the fixtures call the internal checkers directly rather than through a run. -->
    <ProjectReference Include="..\Scribe.StyleEval\Scribe.StyleEval.csproj" />
    <!-- Read the shipping length bands back through the same shim the checker uses, so a fixture
         can never encode a copy of a band that has since been retuned. -->
    <ProjectReference Include="..\Scribe.Evals\Scribe.Evals.csproj" />
  </ItemGroup>

</Project>
