<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 / Windows App SDK 2.2.0 (latest stable) powers the standalone Scribe.Overlay
         recording pill. 2.0 introduced SystemBackdropElement (clipped Acrylic/Mica anywhere in the
         tree with a CornerRadius), the supported floating-glass-pill recipe. The pill runs as its
         own kept-warm, unpackaged self-contained process driven by the WPF app over a named pipe,
         which sidesteps the .NET 10 WPF AllowsTransparency/UpdateLayeredWindow "black box" failure
         (dotnet/wpf #11321) by rendering through DWM composition instead of the legacy layered path. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.2.0" />

    <!-- ASR engine: sherpa-onnx (Apache-2.0) + bundled ONNX Runtime. The native runtime is
         architecture-specific; Scribe.Core references both and selects by RuntimeIdentifier so
         one source tree builds for Intel/AMD and for Snapdragon Copilot+ PCs. -->
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.5" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="1.13.5" />

    <!-- Audio capture -->
    <PackageVersion Include="NAudio" Version="3.0.1" />

    <!-- Persistence. SQLitePCLRaw.bundle_e_sqlite3 is pinned directly to pull a patched native
         e_sqlite3 and override Microsoft.Data.Sqlite's transitive 2.1.11 bundle, which is flagged
         by CVE-2025-6965 (GHSA-2m69-gcr7-jv3q). Keep this pin at or above 3.0.3. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />

    <!-- Hosting / DI / logging / options -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />

    <!-- Tray UI -->
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />

    <!-- Fluent (Windows 11) design system for WPF: themed controls, FluentWindow, Mica. -->
    <PackageVersion Include="WPF-UI" Version="4.3.0" />

    <!-- Optional offline AI cleanup via Foundry Local (self-contained SDK + OpenAI-compatible
         client). The WinML variant is the Windows package: same API surface, but execution provider
         plugins are sourced from the OS and Windows Update with driver compatibility negotiation,
         which is what reaches NPUs (Qualcomm QNN, AMD Vitis) rather than only CPU and WebGPU. -->
    <PackageVersion Include="Microsoft.AI.Foundry.Local.WinML" Version="1.2.4" />
    <!-- OpenAI client and provider-neutral chat abstractions used by Agent Framework. -->
    <!-- Held at 2.12.0 deliberately: Microsoft.Extensions.AI.OpenAI 10.9.0 constrains OpenAI to
         >= 2.12.0 && < 2.13.0, so taking 2.13.0 breaks restore (NU1608). Revisit when
         Microsoft.Extensions.AI.OpenAI widens the range. -->
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <!-- Microsoft.Extensions.AI.Evaluation powers the offline evals harness (tools/Scribe.Evals)
         only; referenced with PrivateAssets=all so it never ships with the WPF app. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation" Version="10.9.0" />

    <!-- Microsoft Agent Framework (GA). Both cleanup providers are unified on its AIAgent primitive.
         Microsoft.Agents.AI.OpenAI supplies the .AsAIAgent(model, instructions, name) extension on the
         OpenAI chat/Responses clients: the classic Azure OpenAI account path uses
         GetResponsesClient().AsAIAgent (the Responses API), and Foundry Local uses
         GetChatClient().AsAIAgent. A Microsoft Foundry *project* endpoint (…/api/projects/…) is turned
         into an AIAgent directly via AIProjectClient.AsAIAgent (Microsoft.Agents.AI.Foundry) over
         Azure.AI.Projects' AIProjectClient, the framework's native Foundry path, no server-side agent. -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.5.0" />
    <PackageVersion Include="Azure.AI.Projects" Version="2.0.1" />

    <!-- Optional cloud AI cleanup via Microsoft Foundry / Azure OpenAI, discovered through the
         user's existing Azure CLI sign-in (AzureCliCredential, AAD tokens, no key stored). -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.ResourceManager.CognitiveServices" Version="1.5.2" />
    <!-- Azure Resource Graph powers a single tenant-wide KQL query to enumerate every chat
         deployment across all subscriptions at once, instead of an N×M per-subscription crawl
         (which times out on large corp tenants). CognitiveServices is kept as a fallback. -->
    <PackageVersion Include="Azure.ResourceManager.ResourceGraph" Version="1.1.1" />

    <!-- Installer + delta auto-update. -->
    <PackageVersion Include="Velopack" Version="1.2.0" />

    <!-- Observability: OpenTelemetry tracing of the dictation lifecycle (capture → VAD → decode →
         AI cleanup → inject). Always-on locally via a log-bridge processor; OTLP export is opt-in
         when OTEL_EXPORTER_OTLP_ENDPOINT is set (Aspire dashboard / Jaeger / any collector). -->
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />

    <!-- DPAPI (Windows) to encrypt the optional Azure API key at rest so it never sits in the
         settings store in plaintext. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />

    <!-- CommonMark parser for the side-testing style suite (tools/Scribe.StyleEval). Referenced
         with PrivateAssets=all from that tool only, which build/pack.ps1 never publishes. -->
    <PackageVersion Include="Markdig" Version="1.3.2" />

    <!-- Test -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
